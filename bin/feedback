#!/usr/bin/env python3
"""feedback-panel: put a long list of items in front of the user as a local web form, autosave
their answers to a JSON file, and let Claude read the result back.

Stdlib only. One shared server on a fixed port (default 8790; "port" in
$FEEDBACK_PANEL_HOME/config.json or FEEDBACK_PORT) serves every form at
http://127.0.0.1:<port>/f/<session>/, with a list of open forms at /. It starts on demand and
replaces itself when this file changes. Forms live in the forms repo (FEEDBACK_FORMS, "forms_repo"
in config.json, or ../Feedback-Forms next to this plugin):

  templates/<name>/   library/<cat>/<name>/   generic answer sets and kept forms
  review/<session>/   open forms, waiting for the user
  done/<session>/     closed forms (`feedback done`), kept as a record

One session = one directory <YYYY-MM-DD-HHMMSS>-<slug>/ holding:

  items.json     the form: items + answer options (see SCHEMA.md)
  page.html      only when the form's template ships its own page
  response.json  what the user answered (autosaved on every change)
  outcomes.json  what Claude did about each item afterwards (shown back in the page)
  server.json    legacy per-session server only (--port N)

Forms answer in one of three ways (`input`):
  choice  every item gets one of the form's `choices` (e.g. Remove / Keep for now / Ask me)
  check   a single tick box per item (`mark_label` says what a tick means)
  text    every item is a question with a free-text answer


Commands:
  new <items.json> [--template NAME] [--suggest S.json] [--name SLUG] [--no-open]
  diagram <file.dot>... [-o items.json] [--font-dir D] [--label NAME]... [--title T]
                                              Graphviz diagram(s) -> items for a clickable review:
                                              every node, connection and zone is an item
  (--port N on new/document/text/email: legacy, the form gets its own server on N)
  status [session]                            one-line state
  result [session] [--json] [--new]                 answers grouped by choice, notes, free text
  wait [session] [--timeout S] [--next]              block until the user presses Submit
  outcome <session> <id> <done|skipped|failed> [text]
  open [session]                              open the form's page
  done [session...]                           close form(s): review/ -> done/
  reopen <session>                            done/ -> review/, and open it
  list [--all]                                open forms (--all: done ones too), newest first
  server [start|stop|restart|status]          the shared form server
  migrate [--review] [--include-live]         move old ~/.local/share sessions into the forms repo
  templates                                   list templates and saved library forms
  template <name>                             print a template's form.json and recipe.md
  save <session> <name> [--generator CMD] [--description TEXT] [--force]
                                              keep this session's form in library/<name>/ (name may
                                              be nested: system-maintenance/btrfs-snapshots)

<session> may be a path, a directory name under the sessions dir, a unique substring of one, or
'latest' (the default). Template names may be prefixed 'library:' or 'templates:' to disambiguate.
"""
import argparse
import datetime as dt
import http.server
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PANEL_HTML = ROOT / "panel" / "index.html"
DIAGRAM_HTML = ROOT / "panel" / "diagram.html"
DOCUMENT_HTML = ROOT / "panel" / "document.html"
CID_RE = re.compile(r"^[A-Za-z0-9_-]{1,40}$")
AUDIO_EXT = {"webm", "ogg", "mp4", "m4a", "wav", "mp3"}
MAX_AUDIO = 60 * 1024 * 1024
# Feedback dimensions per document kind (FRAMEWORK.md rule 2b). `--categories` overrides.
CATEGORY_PRESETS = {
    "designed": ["Wording", "Structure", "Typography", "Colour", "Layout & spacing", "Images & charts", "Other"],
    "text": ["Wording", "Structure", "Tone", "Facts", "Other"],
    "script": ["Wording", "Structure", "Tone", "Facts", "Delivery", "Timing", "Pacing", "Other"],
    "email": ["Recipients", "Subject", "Wording", "Tone", "Facts", "Attachments", "Other"],
}
WORDING_INTENTS = ["Rephrase", "Replace", "Delete", "Insert", "Keep as is"]
VERDICTS = ["Approve as is", "Approve with these changes", "Needs another round"]
FIELD_INTENTS = ["Fine", "Change"]  # email: per-field quick answers
TEXT_SCOPES = ("span", "paragraph", "section", "document")
EMAIL_SCOPES = ("field", "span", "email")
EMAIL_FIELDS = ("from", "to", "cc", "bcc", "subject", "attachments", "body")
WPM = 150  # read-aloud estimate for scripts
SCOPES = ("point", "page", "document", "text", "area")
DATA = Path(os.environ.get("FEEDBACK_PANEL_HOME", Path.home() / ".local/share/feedback-panel"))
try:
    CONFIG = json.loads((DATA / "config.json").read_text())
except (FileNotFoundError, json.JSONDecodeError):
    CONFIG = {}
LEGACY = DATA / "sessions"  # sessions before the shared server (read-only use: result, outcome, migrate)


def _forms_repo():
    for c in (os.environ.get("FEEDBACK_FORMS"), CONFIG.get("forms_repo"), os.environ.get("FEEDBACK_PANEL_TEMPLATES")):
        if c:
            return Path(c).expanduser()
    for name in ("Feedback-Forms", "Feedback-Panel-Templates"):
        if (ROOT.parent / name).exists():
            return ROOT.parent / name
    return DATA  # no forms repo: review/ and done/ live in the data dir


# The forms repo holds everything: templates/, library/, review/ (open forms) and done/ (closed ones).
TEMPLATES = FORMS = _forms_repo()
REVIEW, DONE = FORMS / "review", FORMS / "done"
FORMS_DATA = DATA
HOME = REVIEW  # new sessions are created here
PORT = int(os.environ.get("FEEDBACK_PORT") or CONFIG.get("port") or 8790)
FORM_KEYS = ("title", "instructions", "input", "choices", "mark_label", "mark_tone", "suggest_choice", "submit_hint",
             "note_open", "note_placeholder")
LOCK = threading.Lock()


def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def die(msg, code=1):
    print(f"feedback-panel: {msg}", file=sys.stderr)
    sys.exit(code)


def read_json(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except FileNotFoundError:
        return default


def write_json(p, data):
    p = Path(p)
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(p)


# ---------------------------------------------------------------- sessions

def sessions(where=("review", "done", "legacy")):
    dirs = {"review": REVIEW, "done": DONE, "legacy": LEGACY}
    out = [d for w in where if dirs[w].exists() for d in dirs[w].iterdir() if (d / "items.json").exists()]
    return sorted(out, key=lambda d: d.name, reverse=True)


def state_of(d):
    return "review" if d.parent == REVIEW else "done" if d.parent == DONE else "legacy"


def find_session(name):
    for base in (REVIEW, DONE, LEGACY):
        if (base / name / "items.json").exists():
            return base / name
    return None


def resolve(ref):
    if not ref or ref == "latest":
        s = sessions()
        if not s:
            die("no sessions yet")
        return s[0]
    p = Path(ref).expanduser()
    if (p / "items.json").exists():
        return p.resolve()
    if find_session(ref):
        return find_session(ref)
    matches = [d for d in sessions() if ref in d.name]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:  # open forms first, then newest, for a repeated form name
        return next((d for d in matches if state_of(d) == "review"), matches[0])
    die(f"no session matches {ref!r}")


def all_items(items):
    for g in items.get("groups", []):
        for it in g.get("items", []):
            yield g, it


# ---------------------------------------------------------------- form model

def normalize(items):
    """Fill in input/choices so the page and result only deal with one shape."""
    if items.get("input") not in ("choice", "check", "text"):
        items["input"] = "choice" if items.get("choices") else "check"
    if items["input"] == "check":
        items["choices"] = [{"id": "marked", "label": items.get("mark_label") or "Ticked",
                             "tone": items.get("mark_tone") or "danger"}]
    if items["input"] == "choice" and not items.get("choices"):
        die("input 'choice' needs a 'choices' list")
    for c in items.get("choices", []):
        if "id" not in c or "label" not in c:
            die("every choice needs 'id' and 'label'")
    if items.get("suggest_choice") is None and items.get("choices"):
        items["suggest_choice"] = items["choices"][0]["id"]
    return items


def choices_for(items, group):
    return group.get("choices") or items.get("choices") or []


def validate(items):
    if not isinstance(items.get("groups"), list) or not items["groups"]:
        die("items.json needs a non-empty 'groups' list")
    seen = set()
    for g, it in all_items(items):
        if "id" not in it or "label" not in it:
            die(f"every item needs 'id' and 'label' (group {g.get('name')!r})")
        if it["id"] in seen:
            die(f"duplicate item id {it['id']!r}")
        seen.add(it["id"])
    return len(seen)


def forms(kind):
    """(relative path, dir) for every form under templates/ or library/, nested folders included."""
    base = TEMPLATES / kind
    if not base.exists():
        return []
    return sorted((str(f.parent.relative_to(base)), f.parent) for f in base.rglob("form.json"))


def find_template(name):
    kinds = ("library", "templates")
    if ":" in name:
        k, name = name.split(":", 1)
        kinds = (k,)
    for k in kinds:
        d = TEMPLATES / k / name
        if (d / "form.json").exists():
            return d
    # bare leaf name: library/system-maintenance/software-review answers to "software-review"
    hits = [d for k in kinds for rel, d in forms(k) if rel.split("/")[-1] == name]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"{name!r} is ambiguous: " + ", ".join(str(h.relative_to(TEMPLATES)) for h in hits))
    die(f"no template {name!r} in {TEMPLATES} (try: feedback-panel templates)")


def template_ref(tdir):
    kind, rel = str(tdir.relative_to(TEMPLATES)).split("/", 1)
    return f"{kind}:{rel}"


def fill(s, ctx):
    return re.sub(r"\{(\w+)\}", lambda m: str(ctx.get(m.group(1), m.group(0))), s) if isinstance(s, str) else s


def apply_template(items, tdir):
    form = read_json(tdir / "form.json")
    ctx = {"host": socket.gethostname(), "date": f"{dt.date.today():%Y-%m-%d}"}
    for k in FORM_KEYS:
        if k not in form:
            continue
        # The template decides how the form answers; wording in the items file only wins
        # for title/instructions/submit_hint.
        if k in ("title", "instructions", "submit_hint", "note_placeholder") and k in items:
            continue
        items[k] = fill(form[k], ctx)
    if form.get("input") in ("choice", "text"):
        items.pop("mark_label", None)
    items["_template"] = template_ref(tdir)
    items["_template_form"] = form
    return form


# ---------------------------------------------------------------- server

def server_alive(sess):
    info = read_json(sess / "server.json")
    if not info:
        return None
    try:
        os.kill(info["pid"], 0)
    except (ProcessLookupError, PermissionError):
        return None
    try:
        with socket.create_connection(("127.0.0.1", info["port"]), timeout=1):
            return info
    except OSError:
        return None


def free_port(preferred=0):
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", preferred))
    except OSError:
        s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def code_stamp():
    """Changes when the CLI changes, so a running shared server from older code gets replaced."""
    return int(Path(__file__).resolve().stat().st_mtime)


LOADED_CODE = code_stamp()  # the code this process is running


def ping(timeout=1.0):
    import urllib.request
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/api/ping", timeout=timeout) as r:
            d = json.loads(r.read())
            return d if d.get("feedback") else {}
    except Exception:
        try:  # something answers on the port but it isn't us
            with socket.create_connection(("127.0.0.1", PORT), timeout=timeout):
                return {}
        except OSError:
            return None


def kill_server(info):
    try:
        os.kill(info["pid"], signal.SIGTERM)
    except ProcessLookupError:
        pass
    for _ in range(50):  # until the port is really free
        if ping(0.3) is None:
            return
        time.sleep(0.1)


def ensure_server():
    """One shared form server on PORT for every form. Start it, or replace it if its code is stale."""
    info = ping()
    for _ in range(10):  # a server we just stopped can still hold the port for a moment
        if info != {}:
            break
        time.sleep(0.2)
        info = ping()
    if info == {}:
        die(f"port {PORT} is taken by another program; set \"port\" in {DATA / 'config.json'} or FEEDBACK_PORT")
    if info and info.get("code") == code_stamp() and info.get("forms") == str(FORMS):
        return info
    if info:
        kill_server(info)
    DATA.mkdir(parents=True, exist_ok=True)
    log = open(DATA / "server.log", "a")
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "server", "run"],
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        time.sleep(0.1)
        info = ping(0.3)
        if info:
            return info
    die(f"shared server did not start; see {DATA / 'server.log'}")


def form_url(sess):
    return f"http://127.0.0.1:{PORT}/f/{sess.name}/"


def present(sess, port=0):
    """Serve a session: through the shared server, or (legacy --port N) its own server."""
    if port:
        return start_background(sess, port)
    ensure_server()
    return {"url": form_url(sess)}


def dashboard_html():
    from html import escape
    def rows(ds):
        out = []
        for d in ds:
            it = read_json(d / "items.json") or {}
            st = (read_json(d / "response.json") or {}).get("status", "untouched")
            out.append(f'<li><a href="/f/{escape(d.name)}/">{escape(it.get("title") or d.name)}</a> '
                       f'<span>{escape(it.get("mode") or it.get("input") or "")} · {escape(st)} · {escape(d.name[:10])}</span></li>')
        return "\n".join(out) or "<li><span>none</span></li>"
    return f"""<!doctype html><meta charset="utf-8"><title>Forms</title>
<style>body{{font:15px system-ui,sans-serif;max-width:760px;margin:2em auto;padding:0 1em}}li{{margin:.4em 0}}
span{{color:#777;font-size:13px;margin-left:.5em}}h2{{margin-top:1.6em}}</style>
<h1>Forms</h1><h2>For review</h2><ul>{rows(sessions(("review",)))}</ul>
<h2>Done (latest 30)</h2><ul>{rows(sessions(("done",))[:30])}</ul>"""


def open_browser(url):
    for cmd in (["xdg-open", url], ["open", url]):
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    return False


def make_handler(fixed=None):
    """fixed=None: the shared form server; every form is served under /f/<session>/.
    fixed=<dir>: legacy one-session server at /."""
    class H(http.server.BaseHTTPRequestHandler):
        sess = fixed

        def route(self):
            """Shared server: pick the session from /f/<name>/ and strip the prefix. False = handled."""
            if fixed is not None:
                return True
            path, _, query = self.path.partition("?")
            if path == "/api/ping":
                self.send(200, {"feedback": True, "pid": os.getpid(), "code": LOADED_CODE, "forms": str(FORMS)})
                return False
            if path in ("/", "/index.html"):
                self.send(200, dashboard_html(), "text/html")
                return False
            m = re.match(r"^/f/([A-Za-z0-9._-]+)(/.*)?$", path)
            d = find_session(m.group(1)) if m else None
            if not d:
                self.send(404, {"error": "no such form (moved to done, or deleted?)"})
                return False
            if not m.group(2):  # pages use relative URLs, so the base needs its trailing slash
                self.send_response(301); self.send_header("Location", f"/f/{m.group(1)}/"); self.end_headers()
                return False
            self.sess = d
            self.path = m.group(2) + ("?" + query if query else "")
            return True

        def log_message(self, fmt, *a):
            with open((self.sess or FORMS_DATA) / "server.log", "a") as f:
                f.write(f"{now()} {fmt % a}\n")

        def send(self, code, body, ctype="application/json"):
            if isinstance(body, (dict, list)):
                body = json.dumps(body, ensure_ascii=False)
            if isinstance(body, str):
                body = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", f"{ctype}; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if not self.route():
                return
            path = self.path.split("?")[0]
            if path in ("/", "/index.html"):
                page = self.sess / "page.html" if (self.sess / "page.html").exists() else PANEL_HTML
                return self.send(200, page.read_bytes(), "text/html")
            if path == "/api/session":
                items = read_json(self.sess / "items.json")
                items.pop("_template_form", None)
                if items.get("mode") == "document":
                    lay = []
                    for pg in read_json(self.sess / "layout.json", []):
                        W, H = pg["w"], pg["h"]
                        nb = lambda r: [round(r[0] / W, 5), round(r[1] / H, 5), round(r[2] / W, 5), round(r[3] / H, 5)]
                        lay.append([{"words": [nb(w) for w in l["words"]], "rtl": l["rtl"]}
                                    for b in pg["blocks"] for l in b["lines"] if isinstance(l, dict)])
                    for pg in items.get("pages", []):
                        pg["img"] = pg["img"].lstrip("/")
                    return self.send(200, {"items": items, "layout": lay, "comments": read_json(self.sess / "comments.json", []),
                                           "intents": WORDING_INTENTS, "verdicts": VERDICTS,
                                           "response": read_json(self.sess / "response.json", {}),
                                           "outcomes": read_json(self.sess / "outcomes.json", {}), "session": self.sess.name})
                if items.get("mode") in ("text", "email"):
                    return self.send(200, {"items": items, "comments": read_json(self.sess / "comments.json", []),
                                           "intents": WORDING_INTENTS, "field_intents": FIELD_INTENTS, "verdicts": VERDICTS,
                                           "response": read_json(self.sess / "response.json", {}),
                                           "outcomes": read_json(self.sess / "outcomes.json", {}), "session": self.sess.name})
                return self.send(200, {"items": items, "response": read_json(self.sess / "response.json", {}),
                                       "outcomes": read_json(self.sess / "outcomes.json", {}), "session": self.sess.name})
            if path == "/api/outcomes":
                return self.send(200, read_json(self.sess / "outcomes.json", {}))
            if path == "/api/anchor":  # the text a document comment points at, for the page to show
                cid = dict(kv.split("=", 1) for kv in self.path.partition("?")[2].split("&") if "=" in kv).get("id", "")
                c = next((c for c in read_json(self.sess / "comments.json", []) if c["id"] == cid), None)
                return self.send(200, anchor_text(self.sess, c) if c else {})
            m = re.match(r"^/static/([a-z0-9-]+\.(js|css))$", path)
            if m and (ROOT / "panel" / m.group(1)).exists():
                return self.send(200, (ROOT / "panel" / m.group(1)).read_bytes(),
                                 "text/javascript" if m.group(2) == "js" else "text/css")
            m = re.match(r"^/files/(\d+)/(\d+)$", path)  # email attachment: draft / index
            if m:
                items = read_json(self.sess / "items.json") or {}
                try:
                    att = items["drafts"][int(m.group(1))]["attachments"][int(m.group(2))]
                except (KeyError, IndexError):
                    return self.send(404, {"error": "not found"})
                f = self.sess / "files" / att["file"]
                import mimetypes
                return self.send(200, f.read_bytes(), mimetypes.guess_type(att["name"])[0] or "application/octet-stream")
            m = re.match(r"^/pages/(\d+)\.png$", path)
            if m and (self.sess / "pages" / f"{m.group(1)}.png").exists():
                return self.send(200, (self.sess / "pages" / f"{m.group(1)}.png").read_bytes(), "image/png")
            m = re.match(r"^/audio/([A-Za-z0-9_-]+)\.(\w+)$", path)
            if m and m.group(2) in AUDIO_EXT and (self.sess / "audio" / f"{m.group(1)}.{m.group(2)}").exists():
                return self.send(200, (self.sess / "audio" / f"{m.group(1)}.{m.group(2)}").read_bytes(), f"audio/{m.group(2)}")
            self.send(404, {"error": "not found"})

        def do_POST(self):
            if not self.route():
                return
            path, _, query = self.path.partition("?")
            # Only the page itself may write; blocks drive-by posts from other sites.
            origin = self.headers.get("Origin")
            if origin and not re.match(r"^http://(127\.0\.0\.1|localhost):\d+$", origin):
                return self.send(403, {"error": "bad origin"})
            if path == "/api/audio":
                return self.post_audio(query)
            if path == "/api/comments":
                return self.post_comments()
            if path != "/api/response":
                return self.send(404, {"error": "not found"})
            n = int(self.headers.get("Content-Length", 0))
            try:
                data = json.loads(self.rfile.read(n) or b"{}")
            except json.JSONDecodeError:
                return self.send(400, {"error": "bad json"})
            with LOCK:
                prev = read_json(self.sess / "response.json", {})
                items = read_json(self.sess / "items.json")
                allowed = {it["id"]: {c["id"] for c in choices_for(items, g)} for g, it in all_items(items)}
                entries = {}
                for k, v in (data.get("items") or {}).items():
                    if k not in allowed or not isinstance(v, dict):
                        continue
                    e = {"choice": v.get("choice") if v.get("choice") in allowed[k] else None,
                         "note": str(v.get("note") or ""), "value": str(v.get("value") or "")}
                    if e["choice"] or e["note"].strip() or e["value"].strip():
                        entries[k] = e
                submit = bool(data.get("submit"))
                # Any edit after a submit puts the session back to draft until the next Submit,
                # so `wait` works across repeated rounds.
                resp = {"status": "submitted" if submit else "draft",
                        "general_note": str(data.get("general_note") or ""),
                        "items": entries, "updated": now(), "created": prev.get("created", now()),
                        "submitted_at": now() if submit else prev.get("submitted_at"),
                        "rounds": prev.get("rounds", 0) + (1 if submit else 0)}
                write_json(self.sess / "response.json", resp)
            self.send(200, {"ok": True, "status": resp["status"], "updated": resp["updated"]})

        # ---- document review: voice comments pinned to a page
        def post_audio(self, query):
            q = dict(kv.split("=", 1) for kv in query.split("&") if "=" in kv)
            cid, ext = q.get("id", ""), q.get("ext", "webm")
            n = int(self.headers.get("Content-Length", 0))
            if not CID_RE.match(cid) or ext not in AUDIO_EXT or not 0 < n <= MAX_AUDIO:
                return self.send(400, {"error": "bad audio upload"})
            (self.sess / "audio").mkdir(exist_ok=True)
            name = f"{cid}.{ext}"
            (self.sess / "audio" / name).write_bytes(self.rfile.read(n))
            self.send(200, {"ok": True, "audio": name})

        def post_comments(self):
            n = int(self.headers.get("Content-Length", 0))
            try:
                data = json.loads(self.rfile.read(n) or b"{}")
            except json.JSONDecodeError:
                return self.send(400, {"error": "bad json"})
            items = read_json(self.sess / "items.json")
            if items.get("mode") in ("text", "email"):
                return self.post_textual(items, data)
            npages = len(items.get("pages", []))
            with LOCK:
                old = {c["id"]: c for c in read_json(self.sess / "comments.json", [])}
                out = []
                for c in data.get("comments") or []:
                    cid = str(c.get("id", ""))
                    if not CID_RE.match(cid):
                        continue
                    scope = c.get("scope") if c.get("scope") in SCOPES else "point"
                    page = c.get("page") if isinstance(c.get("page"), int) and 1 <= c["page"] <= npages else None
                    e = {"id": cid, "scope": scope, "page": None if scope == "document" else page,
                         "x": float(c["x"]) if scope == "point" and isinstance(c.get("x"), (int, float)) else None,
                         "y": float(c["y"]) if scope == "point" and isinstance(c.get("y"), (int, float)) else None,
                         "note": str(c.get("note") or ""), "created": old.get(cid, {}).get("created", now())}
                    if scope in ("text", "area"):
                        rects = [[float(v) for v in r][:4] for r in (c.get("rects") or [])[:60]
                                 if isinstance(r, list) and len(r) == 4 and all(isinstance(v, (int, float)) for v in r)]
                        if not rects or page is None:
                            continue
                        e["rects"] = rects
                    cats = items.get("categories") or []
                    if c.get("category") in cats:
                        e["category"] = c["category"]
                    if c.get("intent") in WORDING_INTENTS:
                        e["intent"] = c["intent"]
                    audio = str(c.get("audio") or "")
                    if audio and (self.sess / "audio" / audio).exists() and audio.startswith(cid + "."):
                        e["audio"] = audio
                        e["duration_s"] = c.get("duration_s") if isinstance(c.get("duration_s"), (int, float)) else None
                        prev = old.get(cid, {})
                        if prev.get("audio") == audio and prev.get("transcript"):  # keep a transcript for the same take
                            e["transcript"], e["transcript_by"] = prev["transcript"], prev.get("transcript_by")
                    if e.get("audio") or e["note"].strip() or e.get("intent") or e.get("category"):
                        out.append(e)
                write_json(self.sess / "comments.json", out)
                submit = bool(data.get("submit"))
                prev = read_json(self.sess / "response.json", {})
                resp = {"status": "submitted" if submit else "draft", "updated": now(),
                        "verdict": data.get("verdict") if data.get("verdict") in VERDICTS else prev.get("verdict"),
                        "general_note": str(data.get("general_note") or prev.get("general_note") or ""),
                        "created": prev.get("created", now()),
                        "submitted_at": now() if submit else prev.get("submitted_at"),
                        "rounds": prev.get("rounds", 0) + (1 if submit else 0)}
                write_json(self.sess / "response.json", resp)
            self.send(200, {"ok": True, "status": resp["status"], "updated": resp["updated"], "comments": len(out)})

        def post_textual(self, items, data):
            """Comments for text and email sessions: anchors are character ranges, not page geometry."""
            mode = items["mode"]
            ndrafts = len(items.get("drafts", []))
            cats = items.get("categories") or []
            intents = WORDING_INTENTS + (FIELD_INTENTS if mode == "email" else [])
            txt = lambda v, n=2000: str(v or "")[:n]
            with LOCK:
                old = {c["id"]: c for c in read_json(self.sess / "comments.json", [])}
                out = []
                for c in data.get("comments") or []:
                    cid = str(c.get("id", ""))
                    if not CID_RE.match(cid):
                        continue
                    scopes = TEXT_SCOPES if mode == "text" else EMAIL_SCOPES
                    scope = c.get("scope") if c.get("scope") in scopes else scopes[0]
                    e = {"id": cid, "scope": scope, "note": txt(c.get("note"), 20000),
                         "created": old.get(cid, {}).get("created", now())}
                    for k in ("start", "end", "block", "section"):
                        if isinstance(c.get(k), int) and c[k] >= 0:
                            e[k] = c[k]
                    for k in ("quote", "prefix", "suffix"):
                        if c.get(k):
                            e[k] = txt(c[k])
                    if mode == "email":
                        d = c.get("draft")
                        if not (isinstance(d, int) and 0 <= d < ndrafts):
                            continue
                        e["draft"] = d
                        if scope != "email":
                            if c.get("field") not in EMAIL_FIELDS:
                                continue
                            e["field"] = c["field"]
                    if c.get("category") in cats:
                        e["category"] = c["category"]
                    if c.get("intent") in intents:
                        e["intent"] = c["intent"]
                    audio = str(c.get("audio") or "")
                    if audio and (self.sess / "audio" / audio).exists() and audio.startswith(cid + "."):
                        e["audio"] = audio
                        e["duration_s"] = c.get("duration_s") if isinstance(c.get("duration_s"), (int, float)) else None
                        prev = old.get(cid, {})
                        if prev.get("audio") == audio and prev.get("transcript"):
                            e["transcript"], e["transcript_by"] = prev["transcript"], prev.get("transcript_by")
                    if e.get("audio") or e["note"].strip() or e.get("intent") or e.get("category"):
                        out.append(e)
                write_json(self.sess / "comments.json", out)
                submit = bool(data.get("submit"))
                prev = read_json(self.sess / "response.json", {})
                resp = {"status": "submitted" if submit else "draft", "updated": now(),
                        "verdict": data.get("verdict") if data.get("verdict") in VERDICTS else prev.get("verdict"),
                        "general_note": txt(data.get("general_note") if "general_note" in data else prev.get("general_note"), 20000),
                        "created": prev.get("created", now()),
                        "submitted_at": now() if submit else prev.get("submitted_at"),
                        "rounds": prev.get("rounds", 0) + (1 if submit else 0)}
                if mode == "email":
                    v = data.get("verdicts") if isinstance(data.get("verdicts"), dict) else prev.get("verdicts", {})
                    resp["verdicts"] = {str(k): x for k, x in v.items() if x in VERDICTS and str(k).isdigit() and int(k) < ndrafts}
                    ps = data.get("picked_subject") if isinstance(data.get("picked_subject"), dict) else prev.get("picked_subject", {})
                    resp["picked_subject"] = {str(k): x for k, x in ps.items() if isinstance(x, int) and str(k).isdigit()
                                              and int(k) < ndrafts and 0 <= x < len(items["drafts"][int(k)]["subjects"])}
                write_json(self.sess / "response.json", resp)
            self.send(200, {"ok": True, "status": resp["status"], "updated": resp["updated"], "comments": len(out)})

    return H


def cmd_serve(a):
    sess = resolve(a.session)
    port = free_port(a.port or 0)
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), make_handler(sess))
    url = f"http://127.0.0.1:{port}/"
    write_json(sess / "server.json", {"pid": os.getpid(), "port": port, "url": url, "started": now()})
    # shutdown() from a signal handler on the serving thread deadlocks; just exit.
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    print(url, flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def start_background(sess, port=0):
    log = open(sess / "server.log", "a")
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "serve", str(sess)] + (["--port", str(port)] if port else []),
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        time.sleep(0.1)
        info = server_alive(sess)
        if info:
            return info
    die(f"server did not start; see {sess / 'server.log'}")


def slugify(s):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:40] or "panel"


# ---------------------------------------------------------------- diagrams

SVG_NS = "http://www.w3.org/2000/svg"
XLINK_NS = "http://www.w3.org/1999/xlink"


def svg_text(g):
    return [t.text.strip() for t in g.iter(f"{{{SVG_NS}}}text") if t.text and t.text.strip()]


def font_faces(font_dir):
    """@font-face rules (base64) for every font in font_dir, so the page draws what dot measured."""
    import base64
    rules = []
    for f in sorted(font_dir.iterdir()):
        if f.suffix.lower() not in (".ttf", ".otf", ".woff", ".woff2"):
            continue
        family, weight, style = f.stem, 400, "normal"
        if shutil.which("fc-scan"):
            r = subprocess.run(["fc-scan", "--format", "%{family[0]}|%{weight}|%{slant}", str(f)], capture_output=True, text=True)
            parts = r.stdout.strip().split("|")
            if r.returncode == 0 and len(parts) == 3 and parts[0]:
                family = parts[0]
                fcw = float(parts[1] or 80)  # fontconfig: 80 regular, 180 semibold, 200 bold
                weight = 700 if fcw >= 195 else 600 if fcw >= 175 else 500 if fcw >= 95 else 300 if fcw < 75 else 400
                style = "italic" if parts[2] not in ("", "0") else "normal"
        fmt = {".ttf": "truetype", ".otf": "opentype", ".woff": "woff", ".woff2": "woff2"}[f.suffix.lower()]
        data = base64.b64encode(f.read_bytes()).decode()
        rules.append(f'@font-face {{ font-family: "{family}"; font-weight: {weight}; font-style: {style}; '
                     f'src: url(data:font/{f.suffix[1:].lower()};base64,{data}) format("{fmt}"); }}')
    return "\n".join(rules)


def render_diagram(src, font_dir=None, engine="dot"):
    """Lay out one Graphviz file; return (svg_root, json0) from a single run so both agree."""
    import tempfile
    import xml.etree.ElementTree as ET
    if not shutil.which(engine):
        die(f"Graphviz '{engine}' not found; install graphviz")
    env = dict(os.environ)
    with tempfile.TemporaryDirectory() as tmp:
        if font_dir:
            conf = Path(tmp) / "fonts.conf"
            conf.write_text(f"<fontconfig><dir>{font_dir}</dir><include ignore_missing=\"yes\">/etc/fonts/fonts.conf</include>"
                            f"<cachedir>{tmp}/fc</cachedir></fontconfig>")
            env["FONTCONFIG_FILE"] = str(conf)
        svg_p, js_p = Path(tmp) / "d.svg", Path(tmp) / "d.json"
        r = subprocess.run([engine, "-Tsvg", "-o", str(svg_p), "-Tjson0", "-o", str(js_p), str(src)],
                           capture_output=True, text=True, env=env)
        if r.returncode != 0:
            die(f"{engine} failed on {src}:\n{r.stderr.strip()}")
        ET.register_namespace("", SVG_NS)
        ET.register_namespace("xlink", XLINK_NS)
        return ET.parse(svg_p).getroot(), json.loads(js_p.read_text())


def diagram_items(src, slug, name, font_dir=None, skip=()):
    """One diagram -> (diagram dict for the page, groups of items: components, connections, zones)."""
    import xml.etree.ElementTree as ET
    root, js = render_diagram(src, font_dir)
    objs = js.get("objects", [])
    clusters = [o for o in objs if o.get("name", "").startswith("cluster")]

    def members(c):  # every node in a cluster, nested ones included
        out = set(c.get("nodes", []))
        for sg in c.get("subgraphs", []):
            if objs[sg].get("name", "").startswith("cluster"):
                out |= members(objs[sg])
        return out
    cmembers = {c["name"]: members(c) for c in clusters}
    cparent = {}
    for c in clusters:  # innermost enclosing cluster of each cluster
        outer = [o for o in clusters if o is not c and cmembers[c["name"]] < cmembers[o["name"]]]
        if outer:
            cparent[c["name"]] = min(outer, key=lambda o: len(cmembers[o["name"]]))["name"]
    gv_name = {o["_gvid"]: o["name"] for o in objs}
    zone_of = {}
    for gvid in gv_name:
        inside = [c for c in clusters if gvid in cmembers[c["name"]]]
        if inside:
            zone_of[gv_name[gvid]] = min(inside, key=lambda c: len(cmembers[c["name"]]))["name"]

    pre = f"{slug}:"
    labels, comp, conn, zones, zlabel = {}, [], [], [], {}
    # clusters first so node rows can name their zone by label
    for g in root.iter(f"{{{SVG_NS}}}g"):
        if g.get("class") == "cluster":
            title = g.findtext(f"{{{SVG_NS}}}title", "")
            zlabel[title] = " ".join(svg_text(g)) or title.removeprefix("cluster_").removeprefix("cluster")
    seen_edges = {}
    for g in root.iter(f"{{{SVG_NS}}}g"):
        cls = g.get("class")
        title = g.findtext(f"{{{SVG_NS}}}title", "")
        if cls == "node":
            if title in skip:
                continue
            txt = svg_text(g)
            iid = f"{pre}node:{title}"
            labels[title] = txt[0] if txt else title
            meta = {"diagram": name}
            if title in zone_of:
                meta["zone"] = zlabel.get(zone_of[title], zone_of[title])
            comp.append({"id": iid, "label": labels[title], "detail": " · ".join(txt[1:]), "kind": "node",
                         "diagram": slug, "ref": title, "zone": f"{pre}zone:{zone_of[title]}" if title in zone_of else None,
                         "meta": meta})
            g.set("data-fp", iid)
        elif cls == "cluster":
            iid = f"{pre}zone:{title}"
            meta = {"diagram": name}
            if title in cparent:
                meta["inside"] = zlabel.get(cparent[title], cparent[title])
            zones.append({"id": iid, "label": zlabel[title], "kind": "zone", "diagram": slug, "ref": title,
                          "zone": f"{pre}zone:{cparent[title]}" if title in cparent else None, "meta": meta})
            g.set("data-fp", iid)
    for g in root.iter(f"{{{SVG_NS}}}g"):
        if g.get("class") != "edge":
            continue
        title = g.findtext(f"{{{SVG_NS}}}title", "")
        m = re.match(r"^(.*?)(->|--)(.*)$", title)
        if not m:
            continue
        a, arrow, b = m.group(1).split(":")[0], m.group(2), m.group(3).split(":")[0]
        if a in skip or b in skip:
            continue
        seen_edges[title] = seen_edges.get(title, 0) + 1
        iid = f"{pre}edge:{a}{arrow}{b}" + (f"#{seen_edges[title]}" if seen_edges[title] > 1 else "")
        txt = svg_text(g)
        conn.append({"id": iid, "label": f"{labels.get(a, a)} {'→' if arrow == '->' else '—'} {labels.get(b, b)}",
                     "detail": " · ".join(txt), "kind": "edge", "diagram": slug, "ref": title,
                     "from": f"{pre}node:{a}", "to": f"{pre}node:{b}", "meta": {"diagram": name, "connection": " · ".join(txt)} if txt else {"diagram": name}})
        g.set("data-fp", iid)
    if font_dir:
        style = ET.Element(f"{{{SVG_NS}}}style")
        style.text = font_faces(font_dir)
        root.insert(0, style)
    for attr in ("width", "height"):  # the page sizes it; keep the natural size for fit
        root.set(f"data-{attr}", root.get(attr, ""))
    svg = ET.tostring(root, encoding="unicode")
    groups = [{"name": f"{name}: components", "items": comp},
              {"name": f"{name}: connections", "items": conn, "collapsed": True},
              {"name": f"{name}: zones", "items": zones, "collapsed": True}]
    return {"id": slug, "name": name, "source": str(Path(src).resolve()), "svg": svg}, [g for g in groups if g["items"]]


def cmd_diagram(a):
    names = a.label or []
    diagrams, groups = [], []
    font_dir = Path(a.font_dir).expanduser().resolve() if a.font_dir else None
    for i, f in enumerate(a.files):
        src = Path(f).expanduser()
        if not src.exists():
            die(f"{src} not found")
        name = names[i] if i < len(names) else re.sub(r"[-_]+", " ", src.stem).strip().title()
        d, gs = diagram_items(src, slugify(src.stem), name, font_dir, set(a.skip))
        diagrams.append(d)
        groups += gs
    # No default title: the template's title should win unless --title is given.
    items = ({"title": a.title} if a.title else {}) | {"diagrams": diagrams, "groups": groups}
    n = validate(items)
    if a.out:
        write_json(Path(a.out).expanduser(), items)
        print(json.dumps({"out": str(Path(a.out).expanduser()), "diagrams": [d["name"] for d in diagrams], "items": n,
                          "by_kind": {k: sum(1 for _, it in all_items(items) if it["kind"] == k) for k in ("node", "edge", "zone")}}, indent=2))
    else:
        print(json.dumps(items, ensure_ascii=False))


# ---------------------------------------------------------------- commands

# ---------------------------------------------------------------- document review

def pdf_layout(pdf):
    """Blocks, lines and word rectangles per page, in PDF points, from pdftotext -bbox-layout.
    Text is NOT taken from here: for right-to-left scripts the bbox words come out in visual
    order. Anchor text is cut out with plain pdftotext instead (crop_text). Each line carries
    `rtl` so the page can extend a selection in reading direction."""
    import xml.etree.ElementTree as ET
    raw = subprocess.run(["pdftotext", "-bbox-layout", str(pdf), "-"], capture_output=True, text=True, check=True).stdout
    raw = re.sub(r"<!DOCTYPE[^>]*>", "", raw)
    root = ET.fromstring(raw)
    X = "{http://www.w3.org/1999/xhtml}"
    box = lambda e: [round(float(e.get(k)), 2) for k in ("xMin", "yMin", "xMax", "yMax")]
    rtl_re = re.compile(r"[\u0590-\u08ff\ufb1d-\ufdff\ufe70-\ufeff]")
    pages = []
    for pg in root.iter(X + "page"):
        blocks = []
        for b in pg.iter(X + "block"):
            lines = []
            for l in b.findall(X + "line"):
                words = l.findall(X + "word")
                text = "".join(w.text or "" for w in words)
                lines.append({"box": box(l), "words": [box(w) for w in words], "rtl": bool(rtl_re.search(text))})
            blocks.append({"box": box(b), "lines": lines})
        pages.append({"w": float(pg.get("width")), "h": float(pg.get("height")), "blocks": blocks})
    return pages


def crop_text(pdf, page, rect):
    x0, y0, x1, y1 = rect
    r = subprocess.run(["pdftotext", "-f", str(page), "-l", str(page), "-r", "72", "-x", str(int(x0) - 1),
                        "-y", str(int(y0) - 1), "-W", str(int(x1 - x0) + 3), "-H", str(int(y1 - y0) + 3),
                        str(pdf), "-"], capture_output=True, text=True)
    text = re.sub(r"[\u200e\u200f\u202a-\u202e\u2066-\u2069]", "", r.stdout)  # bidi controls from RTL runs
    return re.sub(r"\s+", " ", text).strip()


def anchor_text(sess, c):
    """What a comment points at, as text in reading order:
    text  -> the exact selected words (`quote`) and the paragraph around them
    area  -> the text inside the box (if any)
    point -> the nearest line and its paragraph"""
    if c.get("page") is None or c.get("scope") in ("page", "document"):
        return {}
    layout = read_json(sess / "layout.json") or []
    if c["page"] > len(layout):
        return {}
    pg = layout[c["page"] - 1]
    W, H = pg["w"], pg["h"]
    pdf = sess / "document.pdf"
    to_pt = lambda r: [r[0] * W, r[1] * H, r[2] * W, r[3] * H]

    def block_at(px, py):
        best = None
        for b in pg["blocks"]:
            for l in b["lines"]:
                lb = l["box"] if isinstance(l, dict) else l
                dy = 0 if lb[1] <= py <= lb[3] else min(abs(py - lb[1]), abs(py - lb[3]))
                dx = 0 if lb[0] <= px <= lb[2] else min(abs(px - lb[0]), abs(px - lb[2]))
                d = dy + 0.1 * dx  # the vertical distance decides
                if best is None or d < best[0]:
                    best = (d, lb, b, dy)
        return best

    if c["scope"] in ("text", "area") and c.get("rects"):
        rects = [to_pt(r) for r in c["rects"]]
        quote = " ".join(t for t in (crop_text(pdf, c["page"], r) for r in rects) if t)
        r0 = rects[0]
        best = block_at((r0[0] + r0[2]) / 2, (r0[1] + r0[3]) / 2)
        out = {"quote": quote[:1200]}
        if best and best[3] <= 30 and c["scope"] == "text":
            para = crop_text(pdf, c["page"], best[2]["box"])
            if para and para != quote:
                out["paragraph"] = para[:600]
        return out
    if c.get("x") is None:
        return {}
    best = block_at(c["x"] * W, c["y"] * H)
    if not best or best[3] > 30:
        return {"near": None}
    return {"line": crop_text(pdf, c["page"], best[1]), "paragraph": crop_text(pdf, c["page"], best[2]["box"])[:600]}


def cmd_document(a):
    src = Path(a.file).expanduser().resolve()
    if not src.exists():
        die(f"{src} not found")
    if src.suffix.lower() != ".pdf":
        die("document review takes a PDF (export other formats to PDF first)")
    for tool in ("pdftoppm", "pdftotext"):
        if not shutil.which(tool):
            die(f"{tool} not found (install poppler-utils)")
    slug = slugify(a.name or src.stem)
    sess = HOME / f"{dt.datetime.now():%Y-%m-%d-%H%M%S}-{slug}"
    (sess / "pages").mkdir(parents=True)
    shutil.copy(src, sess / "document.pdf")
    subprocess.run(["pdftoppm", "-r", str(a.dpi), "-png", str(src), str(sess / "pages" / "p")], check=True)
    pngs = sorted((sess / "pages").glob("p-*.png"), key=lambda p: int(p.stem.split("-")[-1]))
    for i, p in enumerate(pngs, 1):
        p.rename(sess / "pages" / f"{i}.png")
    layout = pdf_layout(src)
    write_json(sess / "layout.json", layout)
    cats = [c.strip() for c in a.categories.split(",") if c.strip()] if a.categories else CATEGORY_PRESETS[a.preset]
    items = {"mode": "document", "title": a.title or src.stem, "source": str(src), "categories": cats,
             "instructions": a.instructions or "Pick a tool: Text (drag across words), Area (draw a box), Pin (click). "
             "Recording starts as soon as you've pointed; Stop or Esc ends it. Tag each comment's category. "
             "'Whole document' for overall points. Choose a verdict and Submit the round.",
             "pages": [{"n": i, "img": f"pages/{i}.png", "w": pg["w"], "h": pg["h"]} for i, pg in enumerate(layout, 1)],
             "input": "document", "groups": []}
    write_json(sess / "items.json", items)
    write_json(sess / "comments.json", [])
    shutil.copy(DOCUMENT_HTML, sess / "page.html")
    info = present(sess, a.port)
    opened = (not a.no_open) and open_browser(info["url"])
    print(json.dumps({"session": str(sess), "url": info["url"], "pages": len(layout), "mode": "document",
                      "browser_opened": bool(opened)}, indent=2))


def asr_config():
    """Transcription backend: any OpenAI-compatible /audio/transcriptions endpoint (hosted Whisper,
    Groq, a self-hosted faster-whisper / speaches server, a local app). Set in the environment or in
    $FEEDBACK_HOME/config.json {"asr": {"url", "key_env", "model", "language", "prompt"}}."""
    cfg = (read_json(HOME.parent / "config.json", {}) or {}).get("asr", {})
    url = os.environ.get("FEEDBACK_ASR_URL") or cfg.get("url")
    key = os.environ.get("FEEDBACK_ASR_KEY") or (os.environ.get(cfg["key_env"]) if cfg.get("key_env") else None)
    return {"url": url, "key": key, "model": os.environ.get("FEEDBACK_ASR_MODEL") or cfg.get("model", "whisper-1"),
            "language": os.environ.get("FEEDBACK_ASR_LANGUAGE") or cfg.get("language"),
            "prompt": cfg.get("prompt")}


def transcribe_file(path, cfg):
    import urllib.request
    import uuid
    boundary = uuid.uuid4().hex
    fields = {"model": cfg["model"], "response_format": "json"}
    if cfg.get("language"):
        fields["language"] = cfg["language"]
    if cfg.get("prompt"):
        fields["prompt"] = cfg["prompt"]
    body = b""
    for k, v in fields.items():
        body += f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode()
    body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{path.name}\"\r\n"
             f"Content-Type: application/octet-stream\r\n\r\n").encode() + path.read_bytes() + f"\r\n--{boundary}--\r\n".encode()
    url = cfg["url"].rstrip("/")
    if not url.endswith("/audio/transcriptions"):
        url += "/audio/transcriptions"
    req = urllib.request.Request(url, data=body, method="POST",
                                 headers={"Content-Type": f"multipart/form-data; boundary={boundary}"})
    if cfg.get("key"):
        req.add_header("Authorization", f"Bearer {cfg['key']}")
    with urllib.request.urlopen(req, timeout=300) as r:
        return json.loads(r.read()).get("text", "").strip()


def cmd_transcribe(a):
    sess = resolve(a.session)
    comments = read_json(sess / "comments.json", [])
    todo = [c for c in comments if c.get("audio") and (a.all or not c.get("transcript"))]
    if a.list:
        print(json.dumps([{"id": c["id"], "audio": str(sess / "audio" / c["audio"])} for c in todo], indent=2))
        return
    if not todo:
        print("nothing to transcribe")
        return
    cfg = asr_config()
    if not cfg["url"]:
        die("no transcription backend: set FEEDBACK_ASR_URL (OpenAI-compatible) or asr.url in config.json; "
            "or run `transcribe --list` and store results with `set-transcript`")
    done = 0
    for c in todo:
        try:
            c["transcript"] = transcribe_file(sess / "audio" / c["audio"], cfg)
            c["transcript_by"] = f"{cfg['model']} @ {cfg['url']}"
            done += 1
        except Exception as e:  # keep going; report the failures
            print(f"{c['id']}: transcription failed: {e}", file=sys.stderr)
    with LOCK:
        cur = {c["id"]: c for c in read_json(sess / "comments.json", [])}
        for c in todo:
            if c["id"] in cur and cur[c["id"]].get("audio") == c["audio"] and c.get("transcript"):
                cur[c["id"]]["transcript"], cur[c["id"]]["transcript_by"] = c["transcript"], c["transcript_by"]
        write_json(sess / "comments.json", list(cur.values()))
    print(f"transcribed {done}/{len(todo)}")


def cmd_set_transcript(a):
    sess = resolve(a.session)
    text = Path(a.file).read_text().strip() if a.file else " ".join(a.text).strip()
    with LOCK:
        comments = read_json(sess / "comments.json", [])
        for c in comments:
            if c["id"] == a.id:
                c["transcript"], c["transcript_by"] = text, a.by or "external"
                break
        else:
            die(f"unknown comment id {a.id!r}")
        write_json(sess / "comments.json", comments)
    print(f"{a.id}: transcript stored")


def document_result(sess):
    items = read_json(sess / "items.json")
    resp = read_json(sess / "response.json", {})
    oc = read_json(sess / "outcomes.json", {})
    order = {"document": 0, "page": 1, "point": 2, "text": 2, "area": 2}
    comments = sorted(read_json(sess / "comments.json", []),
                      key=lambda c: (c.get("page") or 0, order[c["scope"]],
                                     c.get("y") if c.get("y") is not None else (c.get("rects") or [[0, 0]])[0][1]))
    rows = []
    for i, c in enumerate(comments, 1):
        rows.append({"n": i, "id": c["id"], "scope": c["scope"], "page": c.get("page"),
                     "category": c.get("category"), "intent": c.get("intent"), "rects": c.get("rects"),
                     "at": None if c.get("x") is None else {"x": round(c["x"], 3), "y": round(c["y"], 3)},
                     "anchor": anchor_text(sess, c), "note": c.get("note", ""),
                     "transcript": c.get("transcript"), "audio": str(sess / "audio" / c["audio"]) if c.get("audio") else None,
                     "duration_s": c.get("duration_s"), "outcome": oc.get(c["id"])})
    return {"session": str(sess), "mode": "document", "title": items.get("title"), "source": items.get("source"),
            "status": resp.get("status", "untouched"), "rounds": resp.get("rounds", 0), "verdict": resp.get("verdict"),
            "general_note": resp.get("general_note", ""), "comments": rows,
            "by_category": {k: [r["n"] for r in rows if (r.get("category") or "Uncategorised") == k]
                            for k in dict.fromkeys((r.get("category") or "Uncategorised") for r in rows)},
            "untranscribed": sum(1 for r in rows if r["audio"] and not r["transcript"])}


def print_document_result(out):
    print(f"# Feedback on {out['title']}  ({out['status']}, round {out['rounds']}, {len(out['comments'])} comments"
          + (f", {out['untranscribed']} not yet transcribed" if out["untranscribed"] else "") + ")")
    print(f"Source: {out['source']}")
    if out.get("verdict"):
        print(f"Verdict: {out['verdict']}")
    if out.get("general_note"):
        print(f"General note: {out['general_note']}")
    if out["comments"]:
        print("By category: " + "; ".join(f"{k} {', '.join(map(str, v))}" for k, v in out["by_category"].items()))
    for r in out["comments"]:
        kind = {"document": "", "page": "", "point": " (pinned)", "text": " (text)", "area": " (area)"}[r["scope"]]
        where = "Whole document" if r["scope"] == "document" else f"Page {r['page']}{kind}"
        tags = " · ".join(t for t in (r.get("category"), r.get("intent")) if t)
        print(f"\n## {r['n']}. {where}" + (f" — {tags}" if tags else "") + f"  [{r['id']}]")
        an = r.get("anchor") or {}
        if an.get("quote"):
            print(f"> {'selected' if r['scope'] == 'text' else 'in box'}: \"{an['quote'][:600]}\"")
            if an.get("paragraph"):
                print(f"> in: \"{an['paragraph'][:300]}\"")
        if an.get("line"):
            print(f"> at: \"{an['line']}\"")
            if an.get("paragraph") and an["paragraph"] != an["line"]:
                print(f"> in: \"{an['paragraph'][:300]}\"")
        if r["transcript"]:
            print(f"\nSaid: {r['transcript']}")
        elif r["audio"]:
            print(f"\nSaid: (not transcribed yet: {r['audio']})")
        if r["note"]:
            print(f"\nWrote: {r['note']}")
        if r.get("outcome"):
            print(f"\nOutcome: {r['outcome']['state']} {r['outcome'].get('text', '')}")


# ---------------------------------------------------------------- text review (plain text / Markdown)

INLINE_RE = re.compile(r"`([^`\n]+)`|\*\*(.+?)\*\*|__(.+?)__|(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?!\w)|(?<![\w_])_(?!\s)(.+?)(?<!\s)_(?!\w)|\[([^\]\n]+)\]\(([^)\s]+)\)")


def inline_segments(src, start, end, markdown=True):
    """Split source[start:end] into display segments that keep their source offsets:
    [{"t": text, "src": offset, "s": style, "href": url}]. Markup characters are dropped, so the page
    shows clean text while every displayed character still maps back to its place in the file."""
    segs, pos = [], start
    if not markdown:
        return [{"t": src[start:end], "src": start}] if end > start else []
    text = src[start:end]
    for m in INLINE_RE.finditer(text):
        if m.start() > pos - start:
            segs.append({"t": text[pos - start:m.start()], "src": pos})
        for gi, style in ((1, "code"), (2, "b"), (3, "b"), (4, "i"), (5, "i"), (6, "a")):
            if m.group(gi) is not None:
                seg = {"t": m.group(gi), "src": start + m.start(gi), "s": style}
                if style == "a":
                    seg["href"] = m.group(7)
                segs.append(seg)
                break
        pos = start + m.end()
    if pos < end:
        segs.append({"t": text[pos - start:], "src": pos})
    return segs


def parse_text(src, markdown=True):
    """Blocks (heading / paragraph / list item / code) with source ranges, and sections by heading."""
    blocks, i, n = [], 0, len(src)
    lines = src.splitlines(keepends=True)
    offs, o = [], 0
    for ln in lines:
        offs.append(o); o += len(ln)
    k = 0
    para = None

    def flush():
        nonlocal para
        if para:
            s0, e0 = para
            while e0 > s0 and src[e0 - 1] in "\r\n":
                e0 -= 1
            blocks.append({"kind": "p", "start": s0, "end": e0})
        para = None

    while k < len(lines):
        ln, st = lines[k], offs[k]
        body = ln.rstrip("\r\n")
        if markdown and body.lstrip().startswith("```"):
            flush()
            j = k + 1
            while j < len(lines) and not lines[j].lstrip().startswith("```"):
                j += 1
            cs = offs[k + 1] if k + 1 < len(lines) else st + len(ln)
            ce = offs[j] if j < len(lines) else n
            while ce > cs and src[ce - 1] in "\r\n":
                ce -= 1
            blocks.append({"kind": "code", "start": cs, "end": ce})
            k = j + 1
            continue
        if not body.strip():
            flush(); k += 1; continue
        m = re.match(r"^(#{1,6})\s+(.*)$", body) if markdown else None
        if m:
            flush()
            blocks.append({"kind": "h" + str(len(m.group(1))), "start": st + m.start(2), "end": st + len(body.rstrip())})
            k += 1; continue
        m = re.match(r"^(\s*)([-*+]|\d+[.)])\s+", body) if markdown else None
        if m:
            flush()
            blocks.append({"kind": "li", "start": st + m.end(), "end": st + len(body.rstrip()),
                           "marker": m.group(2), "indent": len(m.group(1))})
            k += 1; continue
        if para is None:
            para = [st, st + len(ln)]
        else:
            para[1] = st + len(ln)
        k += 1
    flush()
    sections, cur = [], None
    for bi, b in enumerate(blocks):
        if b["kind"].startswith("h"):
            cur = {"title": src[b["start"]:b["end"]], "level": int(b["kind"][1]), "start": b["start"], "first_block": bi}
            sections.append(cur)
        elif cur is None:
            cur = {"title": "(opening)", "level": 0, "start": b["start"], "first_block": bi}
            sections.append(cur)
        b["section"] = len(sections) - 1
    for si, sec in enumerate(sections):
        if si + 1 < len(sections):
            e = src.rfind("\n", 0, sections[si + 1]["start"]) + 1  # the next heading's line start
            while e > sec["start"] and src[e - 1] in " \t\r\n":
                e -= 1
            sec["end"] = e
        else:
            sec["end"] = n
        words = len(re.findall(r"\w+", src[sec["start"]:sec["end"]]))
        sec["words"], sec["read_s"] = words, round(words / WPM * 60)
    for bi, b in enumerate(blocks):
        b["i"] = bi
        b["segs"] = inline_segments(src, b["start"], b["end"], markdown and b["kind"] != "code")
    return blocks, sections


def new_session(slug):
    sess = HOME / f"{dt.datetime.now():%Y-%m-%d-%H%M%S}-{slug}"
    sess.mkdir(parents=True)
    return sess


def cmd_text(a):
    src_path = Path(a.file).expanduser().resolve()
    if not src_path.exists():
        die(f"{src_path} not found")
    src = src_path.read_text()
    markdown = src_path.suffix.lower() in (".md", ".markdown", ".mdx") or a.markdown
    blocks, sections = parse_text(src, markdown)
    preset = a.preset or "text"
    cats = [c.strip() for c in a.categories.split(",") if c.strip()] if a.categories else CATEGORY_PRESETS[preset]
    sess = new_session(slugify(a.name or src_path.stem))
    shutil.copy(src_path, sess / ("source" + src_path.suffix))
    items = {"mode": "text", "title": a.title or src_path.name, "source": str(src_path), "preset": preset,
             "markdown": markdown, "categories": cats, "text": src, "blocks": blocks, "sections": sections,
             "show_read_time": preset == "script",
             "instructions": a.instructions or "Select any words and talk (or type). Click a paragraph number for "
             "the paragraph, a heading's 🎙 for its section, 'Whole text' for overall points. Tag a category, "
             "pick a verdict and Submit the round.", "groups": [], "input": "text-review"}
    write_json(sess / "items.json", items)
    write_json(sess / "comments.json", [])
    shutil.copy(ROOT / "panel" / "text.html", sess / "page.html")
    info = present(sess, a.port)
    opened = (not a.no_open) and open_browser(info["url"])
    print(json.dumps({"session": str(sess), "url": info["url"], "mode": "text", "blocks": len(blocks),
                      "sections": len(sections), "words": sum(s["words"] for s in sections),
                      "browser_opened": bool(opened)}, indent=2))


def line_of(src, off):
    return src.count("\n", 0, off) + 1


def text_result(sess):
    items = read_json(sess / "items.json")
    src = items["text"]
    resp = read_json(sess / "response.json", {})
    oc = read_json(sess / "outcomes.json", {})
    order = {"document": 0, "section": 1, "paragraph": 2, "span": 3}
    comments = sorted(read_json(sess / "comments.json", []),
                      key=lambda c: (0 if c["scope"] == "document" else 1, c.get("start", 0), order[c["scope"]]))
    rows = []
    for i, c in enumerate(comments, 1):
        st, en = c.get("start"), c.get("end")
        anchor = {}
        if c["scope"] == "paragraph" and c.get("block") is not None and c["block"] < len(items["blocks"]):
            b = items["blocks"][c["block"]]; st, en = b["start"], b["end"]
        if c["scope"] == "section" and c.get("section") is not None and c["section"] < len(items["sections"]):
            sc = items["sections"][c["section"]]; st, en = sc["start"], sc["end"]; anchor["section"] = sc["title"]
        if st is not None and en is not None and 0 <= st <= en <= len(src):
            q = src[st:en]
            anchor.update({"start": st, "end": en, "lines": [line_of(src, st), line_of(src, max(st, en - 1))],
                           "quote": q if len(q) <= 1200 else q[:1200] + "…",
                           "prefix": src[max(0, st - 40):st], "suffix": src[en:en + 40]})
        rows.append({"n": i, "id": c["id"], "scope": c["scope"], "category": c.get("category"), "intent": c.get("intent"),
                     "anchor": anchor, "note": c.get("note", ""), "transcript": c.get("transcript"),
                     "audio": str(sess / "audio" / c["audio"]) if c.get("audio") else None,
                     "duration_s": c.get("duration_s"), "outcome": oc.get(c["id"])})
    return {"session": str(sess), "mode": "text", "title": items.get("title"), "source": items.get("source"),
            "status": resp.get("status", "untouched"), "rounds": resp.get("rounds", 0), "verdict": resp.get("verdict"),
            "general_note": resp.get("general_note", ""), "comments": rows,
            "by_category": {k: [r["n"] for r in rows if (r.get("category") or "Uncategorised") == k]
                            for k in dict.fromkeys((r.get("category") or "Uncategorised") for r in rows)},
            "untranscribed": sum(1 for r in rows if r["audio"] and not r["transcript"])}


def print_head(out):
    print(f"# Feedback on {out['title']}  ({out['status']}, round {out['rounds']}, {len(out['comments'])} comments"
          + (f", {out['untranscribed']} not yet transcribed" if out["untranscribed"] else "") + ")")
    print(f"Source: {out['source']}")
    if out.get("verdict"):
        print(f"Verdict: {out['verdict']}")
    if out.get("general_note"):
        print(f"General note: {out['general_note']}")
    if out["comments"] and out.get("by_category"):
        print("By category: " + "; ".join(f"{k} {', '.join(map(str, v))}" for k, v in out["by_category"].items()))


def print_said(r):
    if r["transcript"]:
        print(f"\nSaid: {r['transcript']}")
    elif r["audio"]:
        print(f"\nSaid: (not transcribed yet: {r['audio']})")
    if r["note"]:
        print(f"\nWrote: {r['note']}")
    if r.get("outcome"):
        print(f"\nOutcome: {r['outcome']['state']} {r['outcome'].get('text', '')}")


def print_text_result(out):
    print_head(out)
    for r in out["comments"]:
        an = r["anchor"]
        where = {"document": "Whole text", "section": f"Section \"{an.get('section', '')}\"",
                 "paragraph": "Paragraph", "span": "Selection"}[r["scope"]]
        if an.get("lines"):
            where += f", line {an['lines'][0]}" + (f"-{an['lines'][1]}" if an["lines"][1] != an["lines"][0] else "")
        tags = " · ".join(t for t in (r.get("category"), r.get("intent")) if t)
        print(f"\n## {r['n']}. {where}" + (f" — {tags}" if tags else "") + f"  [{r['id']}]")
        if an.get("quote") and r["scope"] != "section":
            print(f"> \"{an['quote'][:600]}\"")
        print_said(r)


# ---------------------------------------------------------------- email review

def html_to_text(html):
    """Visible text of an HTML body, for anchoring and the agent's reading (tags dropped, blocks broken)."""
    from html.parser import HTMLParser

    class P(HTMLParser):
        def __init__(self):
            super().__init__(); self.out = []; self.skip = 0
        def handle_starttag(self, t, attrs):
            if t in ("script", "style", "head"):
                self.skip += 1
            if t in ("br", "p", "div", "li", "tr", "h1", "h2", "h3", "h4", "table"):
                self.out.append("\n")
        def handle_endtag(self, t):
            if t in ("script", "style", "head"):
                self.skip -= 1
        def handle_data(self, d):
            if not self.skip:
                self.out.append(d)
    p = P(); p.feed(html)
    return re.sub(r"\n\s*\n+", "\n\n", re.sub(r"[ \t]+", " ", "".join(p.out))).strip()


SAFE_TAGS = {"p", "div", "span", "br", "b", "strong", "i", "em", "u", "a", "ul", "ol", "li", "table", "tr", "td", "th",
             "tbody", "thead", "h1", "h2", "h3", "h4", "blockquote", "img", "hr", "small", "sup", "sub", "pre", "code"}
SAFE_ATTRS = {"dir", "lang", "style", "href", "src", "alt", "width", "height", "align", "colspan", "rowspan"}


def sanitize_html(html):
    """Keep layout tags and dir/lang/style; drop scripts, event handlers and javascript: links."""
    from html.parser import HTMLParser
    from html import escape

    class P(HTMLParser):
        def __init__(self):
            super().__init__(convert_charrefs=True); self.out = []; self.skip = 0
        def handle_starttag(self, t, attrs):
            if t in ("script", "style", "head", "iframe", "object"):
                self.skip += 1; return
            if self.skip or t not in SAFE_TAGS:
                return
            keep = [(k, v) for k, v in attrs if k in SAFE_ATTRS and v is not None
                    and not re.match(r"\s*javascript:", v, re.I)]
            self.out.append(f"<{t}" + "".join(f' {k}="{escape(v)}"' for k, v in keep) + ">")
        def handle_endtag(self, t):
            if t in ("script", "style", "head", "iframe", "object"):
                self.skip = max(0, self.skip - 1); return
            if not self.skip and t in SAFE_TAGS and t not in ("br", "img", "hr"):
                self.out.append(f"</{t}>")
        def handle_data(self, d):
            if not self.skip:
                self.out.append(escape(d))
    p = P(); p.feed(html)
    return "".join(p.out)


def cmd_email(a):
    src_path = Path(a.file).expanduser().resolve()
    data = read_json(src_path)
    if data is None:
        die(f"{src_path} not found")
    raw = data if isinstance(data, list) else data.get("drafts", [data])
    sess = new_session(slugify(a.name or src_path.stem))
    (sess / "files").mkdir()
    drafts = []
    for di, d in enumerate(raw):
        lst = lambda v: [v] if isinstance(v, str) else list(v or [])
        subjects = lst(d.get("subjects") or d.get("subject") or [""])
        body_html = d.get("body_html")
        body_text = d.get("body_text")
        if body_html is None and body_text is None:
            die(f"draft {di + 1}: needs body_html or body_text")
        atts = []
        for ai, att in enumerate(d.get("attachments") or []):
            pth = Path(att["path"] if isinstance(att, dict) else att).expanduser()
            if not pth.exists():
                die(f"draft {di + 1}: attachment {pth} not found")
            fname = f"{di}-{ai}{pth.suffix}"
            shutil.copy(pth, sess / "files" / fname)
            atts.append({"name": (att.get("name") if isinstance(att, dict) else None) or pth.name,
                         "size": pth.stat().st_size, "file": fname, "path": str(pth)})
        drafts.append({"i": di, "label": d.get("label") or ", ".join(lst(d.get("to"))) or f"Draft {di + 1}",
                       "from": d.get("from", ""), "to": lst(d.get("to")), "cc": lst(d.get("cc")), "bcc": lst(d.get("bcc")),
                       "subjects": subjects, "body_html": sanitize_html(body_html) if body_html else None,
                       "body_text": body_text if body_html is None else html_to_text(body_html),
                       "lang": d.get("lang", ""), "dir": d.get("dir") or ("rtl" if d.get("lang") in ("he", "ar", "fa", "ur") else "auto"),
                       "thread": d.get("thread"), "attachments": atts})
    cats = [c.strip() for c in a.categories.split(",") if c.strip()] if a.categories else CATEGORY_PRESETS["email"]
    items = {"mode": "email", "title": a.title or (drafts[0]["subjects"][0] if len(drafts) == 1 else f"{len(drafts)} email drafts"),
             "source": str(src_path), "categories": cats, "drafts": drafts, "groups": [], "input": "email-review",
             "instructions": a.instructions or "Each part of the email has ✓ Fine and ✎ Change. Fine is one tap; "
             "Change (or selecting words in the subject or body) starts a voice comment. Pick a subject if there are "
             "several. Give each draft a verdict: Approve as is means send it."}
    write_json(sess / "items.json", items)
    write_json(sess / "comments.json", [])
    shutil.copy(ROOT / "panel" / "email.html", sess / "page.html")
    info = present(sess, a.port)
    opened = (not a.no_open) and open_browser(info["url"])
    print(json.dumps({"session": str(sess), "url": info["url"], "mode": "email", "drafts": len(drafts),
                      "browser_opened": bool(opened)}, indent=2))


def email_result(sess):
    items = read_json(sess / "items.json")
    resp = read_json(sess / "response.json", {})
    oc = read_json(sess / "outcomes.json", {})
    comments = read_json(sess / "comments.json", [])
    forder = {f: i for i, f in enumerate(("email",) + EMAIL_FIELDS)}
    out_drafts, n = [], 0
    for d in items["drafts"]:
        mine = sorted([c for c in comments if c.get("draft") == d["i"]],
                      key=lambda c: (forder.get(c.get("field", "email"), 0), c.get("start", 0)))
        fields = {}
        rows = []
        for c in mine:
            n += 1
            f = c.get("field", "email")
            changed = c.get("intent") == "Change" or c["scope"] == "span" or (c.get("note") or "").strip() or c.get("audio")
            if f != "email":
                if changed:
                    fields[f] = "Change"
                elif c.get("intent") == "Fine" and fields.get(f) != "Change":
                    fields[f] = "Fine"
            anchor = {"field": f}
            for k in ("quote", "prefix", "suffix", "start", "end"):
                if k in c:
                    anchor[k] = c[k]
            rows.append({"n": n, "id": c["id"], "scope": c["scope"], "category": c.get("category"), "intent": c.get("intent"),
                         "anchor": anchor, "note": c.get("note", ""), "transcript": c.get("transcript"),
                         "audio": str(sess / "audio" / c["audio"]) if c.get("audio") else None,
                         "duration_s": c.get("duration_s"), "outcome": oc.get(c["id"])})
        pick = (resp.get("picked_subject") or {}).get(str(d["i"]))
        out_drafts.append({"draft": d["i"], "label": d["label"], "to": d["to"], "cc": d["cc"],
                           "verdict": (resp.get("verdicts") or {}).get(str(d["i"])),
                           "subject_picked": d["subjects"][pick] if pick is not None else (d["subjects"][0] if len(d["subjects"]) == 1 else None),
                           "subject_options": d["subjects"], "fields": fields, "comments": rows})
    allrows = [r for dd in out_drafts for r in dd["comments"]]
    return {"session": str(sess), "mode": "email", "title": items.get("title"), "source": items.get("source"),
            "status": resp.get("status", "untouched"), "rounds": resp.get("rounds", 0), "verdict": resp.get("verdict"),
            "general_note": resp.get("general_note", ""), "drafts": out_drafts, "comments": allrows,
            "untranscribed": sum(1 for r in allrows if r["audio"] and not r["transcript"])}


def print_email_result(out):
    print_head(out)
    for d in out["drafts"]:
        print(f"\n# Draft {d['draft'] + 1}: {d['label']}  — verdict: {d['verdict'] or '(none)'}")
        if len(d["subject_options"]) > 1:
            print(f"Subject picked: {d['subject_picked'] or '(none picked)'}  (of {len(d['subject_options'])})")
        if d["fields"]:
            print("Fields: " + ", ".join(f"{k} {v}" for k, v in d["fields"].items()))
        for r in d["comments"]:
            an = r["anchor"]
            if r["scope"] == "field" and r.get("intent") == "Fine" and not (r["note"] or r["audio"]):
                continue
            where = "Whole email" if r["scope"] == "email" else f"{an['field'].capitalize()}" + (" (selection)" if r["scope"] == "span" else "")
            tags = " · ".join(t for t in (r.get("category"), r.get("intent")) if t)
            print(f"\n## {r['n']}. {where}" + (f" — {tags}" if tags else "") + f"  [{r['id']}]")
            if an.get("quote"):
                print(f"> \"{an['quote'][:600]}\"")
            print_said(r)


RESULTS = {"document": (lambda s: document_result(s), lambda o: print_document_result(o)),
           "text": (lambda s: text_result(s), lambda o: print_text_result(o)),
           "email": (lambda s: email_result(s), lambda o: print_email_result(o))}


def cmd_new(a):
    src = Path(a.items).expanduser()
    items = read_json(src)
    if items is None:
        die(f"{src} not found")
    n = validate(items)
    tdir = find_template(a.template) if a.template else None
    if tdir:
        apply_template(items, tdir)
    normalize(items)
    if a.suggest:
        sugg = read_json(Path(a.suggest).expanduser())
        if sugg is None:
            die(f"{a.suggest} not found")
        ids = {it["id"]: (g, it) for g, it in all_items(items)}
        unknown = [k for k in sugg if k not in ids]
        if unknown:
            print(f"feedback-panel: ignoring {len(unknown)} unknown suggestion ids: {', '.join(unknown[:5])}", file=sys.stderr)
        for k, s in sugg.items():
            if k not in ids:
                continue
            g, it = ids[k]
            if isinstance(s, dict):  # {"choice": "keep", "reason": "..."}
                it["suggested"] = s.get("reason") or True
                if s.get("choice") in {c["id"] for c in choices_for(items, g)}:
                    it["suggested_choice"] = s["choice"]
            else:
                it["suggested"] = s or True
    slug = slugify(a.name or (tdir.name if tdir else items.get("title", src.stem)))
    sess = HOME / f"{dt.datetime.now():%Y-%m-%d-%H%M%S}-{slug}"
    sess.mkdir(parents=True)
    page = (items.get("_template_form") or {}).get("page")
    if page and (tdir / page).exists():
        shutil.copy(tdir / page, sess / "page.html")
    elif items.get("diagrams"):
        shutil.copy(DIAGRAM_HTML, sess / "page.html")
    write_json(sess / "items.json", items)
    info = present(sess, a.port)
    opened = (not a.no_open) and open_browser(info["url"])
    print(json.dumps({"session": str(sess), "url": info["url"], "items": n, "groups": len(items["groups"]),
                      "input": items["input"], "choices": [c["label"] for c in items.get("choices", [])],
                      "template": items.get("_template"), "browser_opened": bool(opened)}, indent=2))


def legacy(entry):
    """Sessions created before choices existed stored {'marked': bool}."""
    if "choice" not in entry and entry.get("marked"):
        entry = dict(entry, choice="marked")
    return entry


def build_result(sess):
    items = read_json(sess / "items.json")
    normalize(items)
    resp = read_json(sess / "response.json", {})
    answers = {k: legacy(v) for k, v in resp.get("items", {}).items()}
    labels = {c["id"]: c["label"] for g in items["groups"] for c in choices_for(items, g)}
    out = {"session": str(sess), "title": items.get("title", sess.name), "status": resp.get("status", "untouched"),
           "input": items["input"], "rounds": resp.get("rounds", 0), "general_note": resp.get("general_note", ""),
           "choices": labels, "by_choice": {cid: [] for cid in labels}, "answers": [], "notes_only": [],
           "unanswered": 0, "total": 0}
    for g, it in all_items(items):
        out["total"] += 1
        r = answers.get(it["id"], {})
        row = {"id": it["id"], "label": it["label"], "group": g.get("name"), "note": r.get("note", ""),
               "meta": it.get("meta", {})}
        if items["input"] == "text":
            if (r.get("value") or "").strip():
                out["answers"].append(dict(row, answer=r["value"]))
            else:
                out["unanswered"] += 1
            continue
        if r.get("choice"):
            out["by_choice"].setdefault(r["choice"], []).append(row)
        else:
            out["unanswered"] += 1
            if (r.get("note") or "").strip():
                out["notes_only"].append(row)
    out["ticked"] = [r for rows in out["by_choice"].values() for r in rows]  # compat: everything answered
    return items, out


def cmd_status(a):
    sess = resolve(a.session)
    mode = (read_json(sess / "items.json") or {}).get("mode")
    if mode in RESULTS:
        out = RESULTS[mode][0](sess)
        alive = server_alive(sess)
        print(f"{sess.name}: {out['status']} | {len(out['comments'])} comments, {out['untranscribed']} untranscribed | "
              f"round {out['rounds']} | {state_of(sess)} | " + (f"server {alive['url']}" if alive else form_url(sess)))
        return
    items, out = build_result(sess)
    alive = server_alive(sess)
    counts = ", ".join(f"{out['choices'][c]} {len(rows)}" for c, rows in out["by_choice"].items() if rows) or \
        (f"{len(out['answers'])} answered" if out["input"] == "text" else "nothing chosen")
    resp = read_json(sess / "response.json", {})
    print(f"{sess.name}: {out['status']} | {counts} | {out['unanswered']}/{out['total']} unanswered | "
          f"updated {resp.get('updated', '-')} | {state_of(sess)} | " + (f"server {alive['url']}" if alive else form_url(sess)))


def cmd_result(a):
    sess = resolve(a.session)
    mode = (read_json(sess / "items.json") or {}).get("mode")
    if mode in RESULTS:
        out = RESULTS[mode][0](sess)
        if a.new:
            keep = lambda r: (r.get("outcome") or {}).get("state") in (None, "failed")
            out["comments"] = [r for r in out["comments"] if keep(r)]
            for d in out.get("drafts", []):
                d["comments"] = [r for r in d["comments"] if keep(r)]
        print(json.dumps(out, indent=2, ensure_ascii=False)) if a.json else RESULTS[mode][1](out)
        return
    items, out = build_result(sess)
    if a.new:
        # only what still needs acting on: no outcome yet, or the last attempt failed
        oc = read_json(sess / "outcomes.json", {})
        pending = lambda r: oc.get(r["id"], {}).get("state") in (None, "failed")
        out["by_choice"] = {c: [r for r in rows if pending(r)] for c, rows in out["by_choice"].items()}
        for k in ("answers", "notes_only"):
            if k in out:
                out[k] = [r for r in out[k] if pending(r)]
        out["new_only"] = True
    if a.json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    print(f"# {out['title']}  ({out['status']}, round {out['rounds']}, {out['unanswered']}/{out['total']} unanswered)")
    if out["general_note"]:
        print(f"\nGeneral note: {out['general_note']}")

    def block(head, rows, extra=None):
        if not rows:
            return
        print(f"\n## {head} ({len(rows)})")
        grp = None
        for r in rows:
            if r["group"] != grp:
                grp = r["group"]
                print(f"\n### {grp}")
            lab = r["label"] if r["label"] == r["id"] else f"{r['label']}  [{r['id']}]"
            tail = f"  — {r['note']}" if r["note"] else ""
            print(f"- {lab}{tail}")
            if extra:
                print(f"  > {extra(r)}")

    if out["input"] == "text":
        block("Answers", out["answers"], lambda r: r["answer"].replace("\n", "\n  > "))
    for cid, rows in out["by_choice"].items():
        block(out["choices"][cid], rows)
    block("Notes on unanswered items", out["notes_only"])


def cmd_wait(a):
    sess = resolve(a.session)
    t0 = time.time()
    start_round = read_json(sess / "response.json", {}).get("rounds") or 0
    while True:
        resp = read_json(sess / "response.json", {})
        fresh = (resp.get("rounds") or 0) > start_round if a.next else True
        if resp.get("status") == "submitted" and fresh:
            print(f"submitted {resp.get('submitted_at')} (round {resp.get('rounds')})")
            return
        if a.timeout and time.time() - t0 > a.timeout:
            die("timed out waiting for submit", 2)
        time.sleep(2)


def cmd_outcome(a):
    sess = resolve(a.session)
    items = read_json(sess / "items.json")
    valid = {c["id"] for c in read_json(sess / "comments.json", [])} if items.get("mode") in RESULTS \
        else {it["id"] for _, it in all_items(items)}
    if a.id not in valid:
        die(f"unknown item id {a.id!r}")
    with LOCK:
        oc = read_json(sess / "outcomes.json", {})
        oc[a.id] = {"state": a.state, "text": " ".join(a.text), "at": now()}
        write_json(sess / "outcomes.json", oc)
    print(f"{a.id}: {a.state}")


def cmd_open(a):
    sess = resolve(a.session)
    info = server_alive(sess) or (present(sess) if state_of(sess) != "legacy" else start_background(sess))
    open_browser(info["url"])
    print(info["url"])


def cmd_stop(a):
    """Legacy per-session servers only; the shared server is `feedback server stop`."""
    sess = resolve(a.session)
    info = server_alive(sess)
    if not info:
        print("no per-session server (forms use the shared server: `feedback done` closes a form)")
        return
    os.kill(info["pid"], signal.SIGTERM)
    print(f"stopped {info['url']}")


def move_session(sess, dest_dir):
    if sess.parent == dest_dir:
        return sess
    info = server_alive(sess)  # a legacy per-session server would point at the old path
    if info:
        os.kill(info["pid"], signal.SIGTERM)
    for f in ("server.json",):
        (sess / f).unlink(missing_ok=True)
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / sess.name
    if dest.exists():
        die(f"{dest} already exists")
    shutil.move(str(sess), str(dest))
    return dest


def cmd_done(a):
    for ref in a.sessions or ["latest"]:
        sess = resolve(ref)
        if state_of(sess) == "done":
            print(f"{sess.name}: already done")
            continue
        dest = move_session(sess, DONE)
        print(f"{dest.name}: done -> {dest}")


def cmd_reopen(a):
    sess = resolve(a.session)
    dest = move_session(sess, REVIEW)
    ensure_server()
    if not a.no_open:
        open_browser(form_url(dest))
    print(form_url(dest))


def cmd_migrate(a):
    """Move pre-shared-server sessions into the forms repo: done/, or review/ with --review."""
    moved = 0
    for d in sessions(("legacy",)):
        if server_alive(d) and not a.include_live:
            print(f"skip {d.name}: its old server is still running (pass --include-live to stop and move it)")
            continue
        move_session(d, REVIEW if a.review else DONE)
        moved += 1
    print(f"moved {moved} session(s) to {REVIEW if a.review else DONE}")


def cmd_list(a):
    where = ("review", "done", "legacy") if a.all else ("review", "legacy")
    for d in sessions(where):
        resp = read_json(d / "response.json", {})
        tpl = (read_json(d / "items.json") or {}).get("_template", "")
        print(f"{state_of(d):7} {d.name:55} {resp.get('status', 'untouched'):10} {tpl:28} {'up' if server_alive(d) else ''}")


def cmd_server(a):
    if a.action == "run":
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), make_handler(None))
        signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
        print(f"http://127.0.0.1:{PORT}/ serving {FORMS}", flush=True)
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
        return
    info = ping()
    if a.action == "status":
        print(json.dumps({"port": PORT, "url": f"http://127.0.0.1:{PORT}/", "running": bool(info), "forms_repo": str(FORMS),
                          "review": len(sessions(("review",))), "done": len(sessions(("done",))),
                          **({"pid": info["pid"], "stale_code": info.get("code") != code_stamp()} if info else {}),
                          **({"conflict": "port taken by another program"} if info == {} else {})}, indent=2))
    elif a.action == "stop":
        if info:
            kill_server(info)
        print("stopped" if info else "not running")
    else:  # start / restart
        if a.action == "restart" and info:
            kill_server(info)
        ensure_server()
        print(f"http://127.0.0.1:{PORT}/")


def cmd_templates(a):
    if not TEMPLATES.exists():
        die(f"forms repo not found at {TEMPLATES} (clone your forms repo there, or set FEEDBACK_FORMS)")
    for kind in ("templates", "library"):
        fl = forms(kind)
        if not fl:
            continue
        print(f"## {kind}")
        for rel, t in fl:
            f = read_json(t / "form.json")
            opts = " / ".join(c["label"] for c in f.get("choices", [])) or f.get("input", "check")
            print(f"  {rel:40} {opts:34} {f.get('description', '')}")


def cmd_template(a):
    t = find_template(a.name)
    print(f"# {t}\n")
    print((t / "form.json").read_text())
    if (t / "recipe.md").exists():
        print((t / "recipe.md").read_text())


def cmd_save(a):
    sess = resolve(a.session)
    items = read_json(sess / "items.json")
    dest = TEMPLATES / "library" / "/".join(slugify(part) for part in a.name.split("/") if part)
    if (dest / "form.json").exists() and not a.force:
        die(f"{dest} exists; pass --force to update it")
    dest.mkdir(parents=True, exist_ok=True)
    base = items.get("_template_form") or {}
    form = {"name": str(dest.relative_to(TEMPLATES / "library")), "description": a.description or base.get("description") or items.get("title", "")}
    ctx = {"host": socket.gethostname(), "date": f"{dt.date.today():%Y-%m-%d}"}
    for k in FORM_KEYS:
        v = items.get(k, base.get(k))
        # Keep the template's {host}/{date} placeholders unless Claude customised the value.
        if k in base and fill(base[k], ctx) == v:
            v = base[k]
        if v is not None and not (k == "choices" and items.get("input") == "check"):
            form[k] = v
    if a.generator:
        form["generator"] = a.generator
    elif base.get("generator"):
        form["generator"] = base["generator"]
    if (sess / "page.html").exists() and not items.get("diagrams"):
        shutil.copy(sess / "page.html", dest / "page.html")
        form["page"] = "page.html"
    form["based_on"] = items.get("_template", "")
    form["saved"] = f"{dt.date.today():%Y-%m-%d}"
    write_json(dest / "form.json", form)
    write_json(dest / "example-items.json", {k: v for k, v in items.items() if not k.startswith("_")} | {
        "groups": [dict(g, items=g["items"][:3]) for g in items["groups"]]}
        | ({"diagrams": [dict(d, svg="(generated by: feedback-panel diagram)") for d in items["diagrams"]]} if items.get("diagrams") else {}))
    recipe = dest / "recipe.md"
    if not recipe.exists():
        recipe.write_text(f"""# {dest.name}

{form['description']}

## When to use

TODO: the request that should bring this form back.

## Build the items

{('Run: `' + form['generator'] + '` (writes items.json to $OUT).') if form.get('generator') else 'TODO: how to gather the items (commands, sources). One group per kind.'}

## Suggestions

TODO: what Claude tags and why (factual reasons only, never pre-answered).

## Acting on the answers

TODO: what each choice means in practice, commands to run, where to record the outcome.
""")
    print(dest)


def main():
    p = argparse.ArgumentParser(prog="feedback", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)
    x = sp.add_parser("new"); x.add_argument("items"); x.add_argument("--template"); x.add_argument("--name")
    x.add_argument("--no-open", action="store_true"); x.add_argument("--port", type=int, default=0)
    x.add_argument("--suggest", help="JSON {item_id: reason | {choice, reason}} merged in as Claude's suggestions"); x.set_defaults(f=cmd_new)
    x = sp.add_parser("diagram", help="Graphviz file(s) -> items.json for a clickable diagram review")
    x.add_argument("files", nargs="+"); x.add_argument("-o", "--out"); x.add_argument("--title")
    x.add_argument("--label", action="append", help="display name per file, in order (default: from the file name)")
    x.add_argument("--font-dir", help="fonts the diagram uses: dot measures with them and the page embeds them")
    x.add_argument("--skip", action="append", default=["legend"], help="node names to leave out (default: legend)")
    x.set_defaults(f=cmd_diagram)
    x = sp.add_parser("document", help="PDF -> a page you review by pinning voice (or typed) comments")
    x.add_argument("file"); x.add_argument("--title"); x.add_argument("--name"); x.add_argument("--instructions")
    x.add_argument("--dpi", type=int, default=110); x.add_argument("--no-open", action="store_true")
    x.add_argument("--preset", choices=sorted(CATEGORY_PRESETS), default="designed",
                   help="feedback categories: designed (wording + typography, colour, layout...) or text (wording, structure, tone, facts)")
    x.add_argument("--categories", help="comma-separated categories instead of the preset")
    x.add_argument("--port", type=int, default=0); x.set_defaults(f=cmd_document)
    x = sp.add_parser("text", help="plain text / Markdown -> a page you review by selecting words and talking")
    x.add_argument("file"); x.add_argument("--title"); x.add_argument("--name"); x.add_argument("--instructions")
    x.add_argument("--preset", choices=["text", "script"], help="script adds Delivery / Timing / Pacing and read-aloud times")
    x.add_argument("--categories"); x.add_argument("--markdown", action="store_true", help="parse as Markdown whatever the extension")
    x.add_argument("--no-open", action="store_true"); x.add_argument("--port", type=int, default=0); x.set_defaults(f=cmd_text)
    x = sp.add_parser("email", help="email draft(s) JSON -> a page with Fine / Change per field, verdict per draft")
    x.add_argument("file"); x.add_argument("--title"); x.add_argument("--name"); x.add_argument("--instructions")
    x.add_argument("--categories"); x.add_argument("--no-open", action="store_true"); x.add_argument("--port", type=int, default=0)
    x.set_defaults(f=cmd_email)
    x = sp.add_parser("transcribe", help="transcribe a session's voice comments (OpenAI-compatible ASR)")
    x.add_argument("session", nargs="?"); x.add_argument("--all", action="store_true", help="redo existing transcripts")
    x.add_argument("--list", action="store_true", help="print audio files still to transcribe, as JSON"); x.set_defaults(f=cmd_transcribe)
    x = sp.add_parser("set-transcript", help="store a transcript made elsewhere")
    x.add_argument("session"); x.add_argument("id"); x.add_argument("text", nargs="*"); x.add_argument("-f", "--file")
    x.add_argument("--by"); x.set_defaults(f=cmd_set_transcript)
    x = sp.add_parser("serve"); x.add_argument("session"); x.add_argument("--port", type=int, default=0); x.set_defaults(f=cmd_serve)
    for name, f in (("status", cmd_status), ("open", cmd_open), ("stop", cmd_stop)):
        x = sp.add_parser(name); x.add_argument("session", nargs="?"); x.set_defaults(f=f)
    x = sp.add_parser("result"); x.add_argument("session", nargs="?"); x.add_argument("--json", action="store_true"); x.add_argument("--new", action="store_true", help="only items with no outcome yet (or failed)"); x.set_defaults(f=cmd_result)
    x = sp.add_parser("wait"); x.add_argument("session", nargs="?"); x.add_argument("--timeout", type=int, default=0); x.add_argument("--next", action="store_true", help="wait for a Submit newer than the current round"); x.set_defaults(f=cmd_wait)
    x = sp.add_parser("outcome"); x.add_argument("session"); x.add_argument("id"); x.add_argument("state", choices=["done", "skipped", "failed"]); x.add_argument("text", nargs="*"); x.set_defaults(f=cmd_outcome)
    x = sp.add_parser("list"); x.add_argument("--all", action="store_true", help="include done forms"); x.set_defaults(f=cmd_list)
    x = sp.add_parser("done", help="close form(s): move from review/ to done/")
    x.add_argument("sessions", nargs="*"); x.set_defaults(f=cmd_done)
    x = sp.add_parser("reopen", help="move a done form back to review/ and open it")
    x.add_argument("session"); x.add_argument("--no-open", action="store_true"); x.set_defaults(f=cmd_reopen)
    x = sp.add_parser("migrate", help="move old ~/.local/share sessions into the forms repo")
    x.add_argument("--review", action="store_true"); x.add_argument("--include-live", action="store_true"); x.set_defaults(f=cmd_migrate)
    x = sp.add_parser("server", help="the shared form server: start | stop | restart | status | run")
    x.add_argument("action", nargs="?", default="status", choices=["start", "stop", "restart", "status", "run"]); x.set_defaults(f=cmd_server)
    x = sp.add_parser("templates"); x.set_defaults(f=cmd_templates)
    x = sp.add_parser("template"); x.add_argument("name"); x.set_defaults(f=cmd_template)
    x = sp.add_parser("save"); x.add_argument("session"); x.add_argument("name"); x.add_argument("--generator")
    x.add_argument("--description"); x.add_argument("--force", action="store_true"); x.set_defaults(f=cmd_save)
    a = p.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
