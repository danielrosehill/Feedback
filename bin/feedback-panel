#!/usr/bin/env python3
"""feedback-panel: put a long list of items in front of the user as a tick-box web page,
autosave their ticks and notes to a JSON file, and let Claude read the result back.

Stdlib only. One session = one directory under $FEEDBACK_PANEL_HOME (default
~/.local/share/feedback-panel/sessions/<YYYY-MM-DD-HHMM>-<slug>/) holding:

  items.json     what Claude asked about (see SCHEMA.md)
  response.json  what the user ticked / wrote (autosaved on every change)
  outcomes.json  what Claude did about each item afterwards (shown back in the page)
  server.json    pid / port / url of the running server

Commands:
  new <items.json> [--name SLUG] [--suggest S.json] [--no-open] [--port N]
                                                        create a session, start server, open browser
  serve <session>                                       run the server in the foreground
  status [session]                                      one-line state (draft/submitted, counts)
  result [session] [--json]                             ticked items with notes, for Claude to act on
  wait [session] [--timeout S]                          block until the user presses Submit
  outcome <session> <id> <done|skipped|failed> [text]   record what happened to an item
  open [session]                                        reopen the page (restarts server if needed)
  stop [session]                                        stop the server
  list                                                  list sessions, newest first

<session> may be a path, a directory name under the sessions dir, or 'latest' (the default).
"""
import argparse
import datetime as dt
import http.server
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PANEL_HTML = ROOT / "panel" / "index.html"
HOME = Path(os.environ.get("FEEDBACK_PANEL_HOME", Path.home() / ".local/share/feedback-panel")) / "sessions"
LOCK = threading.Lock()


def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def die(msg, code=1):
    print(f"feedback-panel: {msg}", file=sys.stderr)
    sys.exit(code)


def read_json(p, default=None):
    try:
        return json.loads(Path(p).read_text())
    except FileNotFoundError:
        return default


def write_json(p, data):
    p = Path(p)
    tmp = p.with_suffix(p.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    tmp.replace(p)


def sessions():
    if not HOME.exists():
        return []
    return sorted((d for d in HOME.iterdir() if (d / "items.json").exists()), key=lambda d: d.name, reverse=True)


def resolve(ref):
    if not ref or ref == "latest":
        s = sessions()
        if not s:
            die("no sessions yet")
        return s[0]
    p = Path(ref).expanduser()
    if (p / "items.json").exists():
        return p.resolve()
    if (HOME / ref / "items.json").exists():
        return HOME / ref
    matches = [d for d in sessions() if ref in d.name]
    if len(matches) == 1:
        return matches[0]
    die(f"no unique session matches {ref!r}")


def all_items(items):
    for g in items.get("groups", []):
        for it in g.get("items", []):
            yield g, it


def validate(items):
    if not isinstance(items.get("groups"), list) or not items["groups"]:
        die("items.json needs a non-empty 'groups' list")
    seen = set()
    for g, it in all_items(items):
        if "id" not in it or "label" not in it:
            die(f"every item needs 'id' and 'label' (group {g.get('name')!r})")
        if it["id"] in seen:
            die(f"duplicate item id {it['id']!r}")
        seen.add(it["id"])
    return len(seen)


def server_alive(sess):
    info = read_json(sess / "server.json")
    if not info:
        return None
    try:
        os.kill(info["pid"], 0)
    except (ProcessLookupError, PermissionError):
        return None
    try:
        with socket.create_connection(("127.0.0.1", info["port"]), timeout=1):
            return info
    except OSError:
        return None


def free_port(preferred=0):
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", preferred))
    except OSError:
        s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def open_browser(url):
    for cmd in (["xdg-open", url], ["open", url]):
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return True
    return False


# ---------------------------------------------------------------- server

def make_handler(sess):
    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, fmt, *a):
            with open(sess / "server.log", "a") as f:
                f.write(f"{now()} {fmt % a}\n")

        def send(self, code, body, ctype="application/json"):
            if isinstance(body, (dict, list)):
                body = json.dumps(body, ensure_ascii=False)
            if isinstance(body, str):
                body = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", f"{ctype}; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = self.path.split("?")[0]
            if path in ("/", "/index.html"):
                return self.send(200, PANEL_HTML.read_bytes(), "text/html")
            if path == "/api/session":
                return self.send(200, {
                    "items": read_json(sess / "items.json"),
                    "response": read_json(sess / "response.json", {}),
                    "outcomes": read_json(sess / "outcomes.json", {}),
                    "session": sess.name,
                })
            if path == "/api/outcomes":
                return self.send(200, read_json(sess / "outcomes.json", {}))
            self.send(404, {"error": "not found"})

        def do_POST(self):
            if self.path != "/api/response":
                return self.send(404, {"error": "not found"})
            # Only accept same-origin posts (the page itself); blocks drive-by posts from other sites.
            origin = self.headers.get("Origin")
            if origin and not re.match(r"^http://(127\.0\.0\.1|localhost):\d+$", origin):
                return self.send(403, {"error": "bad origin"})
            n = int(self.headers.get("Content-Length", 0))
            try:
                data = json.loads(self.rfile.read(n) or b"{}")
            except json.JSONDecodeError:
                return self.send(400, {"error": "bad json"})
            with LOCK:
                prev = read_json(sess / "response.json", {})
                items = read_json(sess / "items.json")
                valid = {it["id"] for _, it in all_items(items)}
                entries = {k: v for k, v in (data.get("items") or {}).items() if k in valid}
                submit = bool(data.get("submit"))
                # Any edit after a submit puts the session back to draft until the next Submit,
                # so `wait` works across repeated rounds.
                resp = {
                    "status": "submitted" if submit else "draft",
                    "general_note": data.get("general_note", ""),
                    "items": entries,
                    "updated": now(),
                    "created": prev.get("created", now()),
                    "submitted_at": now() if submit else prev.get("submitted_at"),
                    "rounds": prev.get("rounds", 0) + (1 if submit else 0),
                }
                write_json(sess / "response.json", resp)
            self.send(200, {"ok": True, "status": resp["status"], "updated": resp["updated"]})

    return H


def cmd_serve(a):
    sess = resolve(a.session)
    port = free_port(a.port or 0)
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), make_handler(sess))
    url = f"http://127.0.0.1:{port}/"
    write_json(sess / "server.json", {"pid": os.getpid(), "port": port, "url": url, "started": now()})
    # shutdown() from a signal handler on the serving thread deadlocks; just exit.
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    print(url, flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def start_background(sess, port=0):
    log = open(sess / "server.log", "a")
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "serve", str(sess)] + (["--port", str(port)] if port else []),
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(50):
        time.sleep(0.1)
        info = server_alive(sess)
        if info:
            return info
    die(f"server did not start; see {sess/'server.log'}")


def slugify(s):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:40] or "panel"


def cmd_new(a):
    src = Path(a.items).expanduser()
    items = read_json(src)
    if items is None:
        die(f"{src} not found")
    n = validate(items)
    if a.suggest:
        sugg = read_json(Path(a.suggest).expanduser())
        if sugg is None:
            die(f"{a.suggest} not found")
        ids = {it["id"]: it for _, it in all_items(items)}
        unknown = [k for k in sugg if k not in ids]
        if unknown:
            print(f"feedback-panel: ignoring {len(unknown)} unknown suggestion ids: {', '.join(unknown[:5])}", file=sys.stderr)
        for k, reason in sugg.items():
            if k in ids:
                ids[k]["suggested"] = reason or True
    slug = slugify(a.name or items.get("title", src.stem))
    sess = HOME / f"{dt.datetime.now():%Y-%m-%d-%H%M%S}-{slug}"
    sess.mkdir(parents=True)
    write_json(sess / "items.json", items)
    info = start_background(sess, a.port)
    opened = (not a.no_open) and open_browser(info["url"])
    print(json.dumps({"session": str(sess), "url": info["url"], "items": n,
                      "groups": len(items["groups"]), "browser_opened": bool(opened)}, indent=2))


def summarize(sess):
    items = read_json(sess / "items.json")
    resp = read_json(sess / "response.json", {})
    marks = {k: v for k, v in resp.get("items", {}).items() if v.get("marked")}
    notes = {k: v for k, v in resp.get("items", {}).items() if (v.get("note") or "").strip()}
    total = sum(1 for _ in all_items(items))
    return items, resp, marks, notes, total


def cmd_status(a):
    sess = resolve(a.session)
    items, resp, marks, notes, total = summarize(sess)
    alive = server_alive(sess)
    print(f"{sess.name}: {resp.get('status', 'untouched')} | {len(marks)}/{total} ticked | "
          f"{len(notes)} notes | updated {resp.get('updated', '-')} | "
          f"server {'up ' + alive['url'] if alive else 'down'}")


def cmd_result(a):
    sess = resolve(a.session)
    items, resp, marks, notes, total = summarize(sess)
    mark_label = items.get("mark_label", "Ticked")
    out = {"session": str(sess), "status": resp.get("status", "untouched"), "mark_label": mark_label,
           "general_note": resp.get("general_note", ""), "ticked": [], "notes_only": []}
    for g, it in all_items(items):
        r = resp.get("items", {}).get(it["id"], {})
        row = {"id": it["id"], "label": it["label"], "group": g.get("name"), "note": r.get("note", ""),
               "meta": it.get("meta", {})}
        if r.get("marked"):
            out["ticked"].append(row)
        elif (r.get("note") or "").strip():
            out["notes_only"].append(row)
    if a.json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    print(f"# {items.get('title', sess.name)}  ({out['status']}, {len(out['ticked'])}/{total} {mark_label.lower()})")
    if out["general_note"]:
        print(f"\nGeneral note: {out['general_note']}")
    for key, head in (("ticked", mark_label), ("notes_only", "Notes on unticked items")):
        if out[key]:
            print(f"\n## {head}")
            grp = None
            for r in out[key]:
                if r["group"] != grp:
                    grp = r["group"]
                    print(f"\n### {grp}")
                lab = r["label"] if r["label"] == r["id"] else f"{r['label']}  [{r['id']}]"
                print(f"- {lab}" + (f"  — {r['note']}" if r["note"] else ""))


def cmd_wait(a):
    sess = resolve(a.session)
    t0 = time.time()
    while True:
        resp = read_json(sess / "response.json", {})
        if resp.get("status") == "submitted":
            print(f"submitted {resp.get('submitted_at')}")
            return
        if a.timeout and time.time() - t0 > a.timeout:
            die("timed out waiting for submit", 2)
        time.sleep(2)


def cmd_outcome(a):
    sess = resolve(a.session)
    valid = {it["id"] for _, it in all_items(read_json(sess / "items.json"))}
    if a.id not in valid:
        die(f"unknown item id {a.id!r}")
    with LOCK:
        oc = read_json(sess / "outcomes.json", {})
        oc[a.id] = {"state": a.state, "text": " ".join(a.text), "at": now()}
        write_json(sess / "outcomes.json", oc)
    print(f"{a.id}: {a.state}")


def cmd_open(a):
    sess = resolve(a.session)
    info = server_alive(sess) or start_background(sess)
    open_browser(info["url"])
    print(info["url"])


def cmd_stop(a):
    sess = resolve(a.session)
    info = server_alive(sess)
    if not info:
        print("not running")
        return
    os.kill(info["pid"], signal.SIGTERM)
    print(f"stopped {info['url']}")


def cmd_list(a):
    for d in sessions():
        resp = read_json(d / "response.json", {})
        print(f"{d.name:60} {resp.get('status', 'untouched'):10} {'up' if server_alive(d) else ''}")


def main():
    p = argparse.ArgumentParser(prog="feedback-panel", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)
    x = sp.add_parser("new"); x.add_argument("items"); x.add_argument("--name"); x.add_argument("--no-open", action="store_true"); x.add_argument("--port", type=int, default=0); x.add_argument("--suggest", help="JSON {item_id: reason} merged in as Claude's suggestions"); x.set_defaults(f=cmd_new)
    x = sp.add_parser("serve"); x.add_argument("session"); x.add_argument("--port", type=int, default=0); x.set_defaults(f=cmd_serve)
    for name, f in (("status", cmd_status), ("open", cmd_open), ("stop", cmd_stop)):
        x = sp.add_parser(name); x.add_argument("session", nargs="?"); x.set_defaults(f=f)
    x = sp.add_parser("result"); x.add_argument("session", nargs="?"); x.add_argument("--json", action="store_true"); x.set_defaults(f=cmd_result)
    x = sp.add_parser("wait"); x.add_argument("session", nargs="?"); x.add_argument("--timeout", type=int, default=0); x.set_defaults(f=cmd_wait)
    x = sp.add_parser("outcome"); x.add_argument("session"); x.add_argument("id"); x.add_argument("state", choices=["done", "skipped", "failed"]); x.add_argument("text", nargs="*"); x.set_defaults(f=cmd_outcome)
    x = sp.add_parser("list"); x.set_defaults(f=cmd_list)
    a = p.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
